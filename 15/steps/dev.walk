walkthrough "macos 15 - developer toolchain"
resolution 1920x1080
recording_resolution 1920x1080
user vmuser
var out
  default out/distro.qcow2
  from args.out
password admin
var shutdown
  default ssh
  from args.shutdown
var user
  default vmuser
  from args.user
boot_disk from_caller
ssh_port 2222
step "the media this stage boots from is already on disk"
  needs [boot.img, macos.rom, macos.vars, Xcode_26.3_Universal.xip, node.pkg, python.pkg]


step "boot the disk"
  boot
    machine "q35,accel=kvm,vmport=off"
    args [["-m", "12288"], ["-drive", "if=pflash,format=raw,readonly=on,file={{dir}}/macos.rom"], ["-drive", "if=pflash,format=raw,file={{dir}}/macos.vars"], ["-drive", "file={{dir}}/boot.img,format=raw,if=none,id=oc"], ["-device", "virtio-blk-pci,drive=oc,bootindex=0"], ["-chardev", "socket,id=qga0,path={{work}}/qga.sock,server=on,wait=off"], ["-device", "isa-serial,chardev=qga0"], ["-device", "qemu-xhci,id=xhci"], ["-device", "usb-tablet,bus=xhci.0"], ["-device", "usb-kbd,bus=xhci.0"], ["-drive", "file={{disk}},if=none,format=qcow2,discard=unmap,id=target"], ["-device", "virtio-blk-pci,drive=target,bootindex=1"], ["-global", "ICH9-LPC.disable_s3=1"], ["-global", "ICH9-LPC.disable_s4=1"], ["-global", "ICH9-LPC.acpi-pci-hotplug-with-bridge-support=off"], ["-rtc", "base=utc"], ["-smbios", "type=2"], ["-device", "vmware-svga"], ["-audiodev", "none,id=snd0"], ["-device", "usb-audio,bus=xhci.0,audiodev=snd0"], ["-device", "isa-applesmc,osk=ourhardworkbythesewordsguardedpleasedontsteal(c)AppleComputerInc"], ["-netdev", "tap,id=net0,ifname=qemutap0,script=no,downscript=no"], ["-device", "virtio-net-pci,netdev=net0,mac=52:54:00:56:4d:01,romfile=,host_mtu=1450"]]
    timeout 900
step "wait for sshd"
  repeat
    until machine_ssh
    max 90
    pause 10


step "copy xcode into the guest"
  copy Xcode_26.3_Universal.xip /tmp/Xcode.xip


step "copy run-xcode-install.sh in"
  copy run-xcode-install.sh /tmp/run-xcode-install.sh
  timeout 300


step "expand and select xcode"
  ssh "bash /tmp/run-xcode-install.sh '{{ password }}'"
  timeout 7200


step "remove the xip"
  ssh "rm -f /Users/{{ user }}/Xcode.xip && df -h / | tail -1"
  timeout 300
# THE STEP THAT USED TO SIT HERE HAD NO KEYS AT ALL, AND AN EMPTY STEP IS A RUNTIME FAILURE.
#
# UPSTREAM'S JOB 133769640513 FAILED ON EXACTLY THAT, and the message is the one an empty step
# produces:
#
#	fetch the packages on the host: no implementation for this step's keys
#
# It is still an empty `- name:` with only comments under it on upstream HEAD, so the conversion
# reproduced it faithfully and then could not run it. `runOne` refuses a spec with no action:
#
#	empty: no implementation for this step's keys
#
# THE JOB IT WAS TRYING TO DO IS ALREADY DONE ELSEWHERE. `fetchDevPackages` pulls `dev-node-pkg` and
# `dev-python-pkg`; in this workflow both arrive through `assets:` BEFORE the run starts, which is the
# rule every stage here follows. So the step has nothing left to do and is removed rather than
# invented: `scp: [node.pkg, /tmp/node.pkg]` below is the step that proves the files are there.


step "copy the packages into the guest"
  copy node.pkg /tmp/node.pkg


step "copy the python package into the guest"
  copy python.pkg /tmp/python.pkg


step "copy install-node.sh in"
  copy install-node.sh /tmp/install-node.sh
  timeout 300


step "install node"
  ssh "bash /tmp/install-node.sh '{{ password }}'"
  timeout 1800


step "copy install-python.sh in"
  copy install-python.sh /tmp/install-python.sh
  timeout 300


step "install python"
  ssh "bash /tmp/install-python.sh '{{ password }}'"
  timeout 1800


step "copy prove-toolchain.sh in"
  copy prove-toolchain.sh /tmp/prove-toolchain.sh
  timeout 300


step "prove the toolchain"
  ssh "bash /tmp/prove-toolchain.sh"
  timeout 300


step "prove xcode is selected"
  ssh "xcode-select -p && xcodebuild -version"
  timeout 300


step "copy swift-check.sh in"
  copy swift-check.sh /tmp/swift-check.sh
  timeout 300


step "prove swift compiles"
  ssh "sh /tmp/swift-check.sh"
  timeout 1800


step "note what is present"
  ssh "export PATH=/usr/local/bin:$PATH; echo \"node=$(node --version)\"; echo \"python=$(python3 --version)\"; echo \"git=$(git --version)\"; echo \"swift=$(swift --version 2>&1 | head -1)\"; echo \"xcode=$(xcodebuild -version | head -1)\""
  timeout 300


step "stop the machine"
  stop "{{ shutdown }}"
  timeout 300


step "publish the disk"
  save "{{ out }}"
