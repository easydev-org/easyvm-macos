walkthrough "macos 15 ssh - the setup assistant, remote login, and a graceful shutdown"
resolution 1920x1080
recording_resolution 1920x1080
user vmuser
var out
  default out/macos15-ssh.qcow2
  from args.out
password admin
var user
  default vmuser
  from args.user
boot_disk from_caller
ssh_port 2222


step "the media this stage boots from is already on disk"
  needs [boot.img, macos.rom, macos.vars]


step "boot the disk"
  boot
    machine "q35,accel=kvm,vmport=off"
    # THE WRITES GO TO A THROWAWAY DIFF, LIKE EVERY OTHER STAGE HERE.
    #
    # THIS FILE USED `overlay false`, AND THE PUBLISHED DISK PAID FOR IT. MEASURED, the same two stages
    # side by side:
    #
    #	             boot                 base before   base after   published
    #	macos 15     overlay false        28620 MiB     40981 MiB    34589 MiB
    #	macos 26     diff over the base   33618 MiB     33618 MiB    16407 MiB
    #
    # MACOS 26'S BASE IS 5 GiB LARGER AND ITS PRODUCT IS 18 GiB SMALLER, because with a diff the base
    # is never written and the published file is the compressed flatten of a diff that holds only what
    # the guest actually added. With `overlay false` every write lands in the base, `discard=unmap`
    # reaches the base, and the file that gets compressed is 41 GiB of mostly-free space.
    #
    # THE REASON IT WAS TURNED OFF WAS A PEAK, NOT A RESULT: at the time this stage published 42.2 GiB
    # of output and the base plus a live diff plus that output did not fit in 84 GiB. THAT PEAK IS GONE
    # FOR A REASON THAT HAS NOTHING TO DO WITH OVERLAYS: the recording now ends before `publish`, and a
    # diff that is 12 GiB smaller than the growth this file used to cause leaves the same three files
    # comfortably inside the runner. Measured on macos 26, which has always used a diff and has never
    # needed the room this file gave up its guarantees for.
    #
    # WHAT COMES BACK WITH THE DIFF: a failed run leaves the published disk untouched, and the guest's
    # TRIM cannot reach the base. Both were given away here for a peak that no longer exists.
    args [["-m", "12288"], ["-cpu", "Skylake-Client-v4,vendor=GenuineIntel,vmx=off,vmware-cpuid-freq=on,-pdpe1gb,+invtsc,+ssse3,+sse4.2,+popcnt,+avx,+avx2,+aes,+fma,+bmi1,+bmi2,+smep,+xsave,+xsaveopt,+xgetbv1,+movbe,+rdrand,check"], ["-smp", "4,sockets=1,dies=1,cores=4,threads=1"], ["-drive", "if=pflash,format=raw,readonly=on,file=macos.rom"], ["-drive", "if=pflash,format=raw,file=macos.vars"], ["-drive", "file=boot.img,format=raw,if=none,id=oc"], ["-device", "virtio-blk-pci,drive=oc,bootindex=0"], ["-chardev", "socket,id=qga0,path=qga.sock,server=on,wait=off"], ["-device", "isa-serial,chardev=qga0"], ["-device", "qemu-xhci,id=xhci"], ["-device", "usb-tablet,bus=xhci.0"], ["-device", "usb-kbd,bus=xhci.0"], ["-drive", "file=disk.qcow2,if=none,format=qcow2,discard=unmap,id=target"], ["-device", "virtio-blk-pci,drive=target,bootindex=1"], ["-global", "ICH9-LPC.disable_s3=1"], ["-global", "ICH9-LPC.disable_s4=1"], ["-global", "ICH9-LPC.acpi-pci-hotplug-with-bridge-support=off"], ["-rtc", "base=utc"], ["-smbios", "type=2"], ["-device", "vmware-svga"], ["-audiodev", "none,id=snd0"], ["-device", "usb-audio,bus=xhci.0,audiodev=snd0"], ["-device", "isa-applesmc,osk=ourhardworkbythesewordsguardedpleasedontsteal(c)AppleComputerInc"], ["-netdev", "tap,id=net0,ifname=qemutap0,script=no,downscript=no"], ["-device", "virtio-net-pci,netdev=net0,mac=52:54:00:56:4d:01,romfile=,host_mtu=1450"]]
    timeout 900
step "answer the wizard until the desktop appears"
  repeat
    do
      item "read the pane"
        read
          name pane
      item "classify - analytics"
        check
          source pane
          mode text
          name analytics
          rect [0, 0, 1920, 1080]
          rect_at [1920, 1080]
          words [[share, analytics, with, apple]]
      item "classify - data and privacy"
        check
          source pane
          mode text
          name privacy_pane
          rect [0, 0, 1920, 1080]
          rect_at [1920, 1080]
          words [[privacy, fundamental]]
      item "classify - spoken languages"
        check
          source pane
          mode text
          name languages
          rect [0, 0, 1920, 1080]
          rect_at [1920, 1080]
          words [[spoken, languages]]
      item "classify - accessibility"
        check
          source pane
          mode text
          name accessibility
          rect [0, 0, 1920, 1080]
          rect_at [1920, 1080]
          words [[accessibility, individual]]
      item "classify - transfer"
        check
          source pane
          mode text
          name transfer
          rect [0, 0, 1920, 1080]
          rect_at [1920, 1080]
          words [[transfer, your, information, to, this, mac]]
      item "classify - country"
        check
          source pane
          mode text
          name country
          rect [0, 0, 1920, 1080]
          rect_at [1920, 1080]
          words [[select, your, country, or, region]]
      item "classify - account"
        check
          source pane
          mode text
          name account
          rect [0, 0, 1920, 1080]
          rect_at [1920, 1080]
          words [[create, a, mac, account]]
      item "classify - location"
        check
          source pane
          mode text
          name location
          rect [0, 0, 1920, 1080]
          rect_at [1920, 1080]
          words [[enable, location, services]]
      item "classify - screen time"
        check
          source pane
          mode text
          name screen_time
          rect [0, 0, 1920, 1080]
          rect_at [1920, 1080]
          words [[screen, time]]
      item "classify - time zone"
        check
          source pane
          mode text
          name time_zone
          rect [0, 0, 1920, 1080]
          rect_at [1920, 1080]
          words [[time, zone]]
      item "classify - look"
        check
          source pane
          mode text
          name look
          rect [0, 0, 1920, 1080]
          rect_at [1920, 1080]
          words [[choose, your, look]]
      # THE THREE CHECKS BELOW WERE TOO LOOSE AND IT COST A WHOLE RUN.
      #
      # MEASURED on run 45740428755, at the Terms and Conditions pane. One reading answered:
      #
      #	[8.13] terms         = true (read "terms")
      #	[8.14] welcome       = true (read "mac")        <- the licence says "macOS" twelve times
      #	[8.16] apple_account = true (read "in")         <- "in" is in every sentence of a licence
      #	[8.17] apple_sheet   = true (read "are")        <- so is "are"
      #
      # SO FOUR BRANCHES RAN ON ONE PANE, and the `welcome` clicks - which belong to a page two steps
      # later - landed on the licence text. The pane never advanced and the run spent fifty minutes
      # there until it was cancelled.
      #
      # EACH NOW REQUIRES THE PHRAASE ITS OWN PAGE CARRIES, and macos 26 had already been fixed this
      # way: `welcome` needs `welcome to your mac`, `apple_account` needs `apple id`, and the
      # confirmation sheet needs the sheet's own `sure skip signing`.
      item "classify - terms"
        check
          source pane
          mode text
          name terms
          rect [0, 0, 1920, 1080]
          rect_at [1920, 1080]
          words [[terms, conditions]]
      item "classify - welcome"
        check
          source pane
          mode text
          name welcome
          rect [0, 0, 1920, 1080]
          rect_at [1920, 1080]
          words [[welcome, to, your, mac]]
      item "classify - keyboard"
        check
          source pane
          mode text
          name keyboard
          rect [0, 0, 1920, 1080]
          rect_at [1920, 1080]
          words [[keyboard, assistant]]
      item "classify - apple account"
        check
          source pane
          mode text
          name apple_account
          rect [0, 0, 1920, 1080]
          rect_at [1920, 1080]
          words [[sign, in, to, your, apple, account, id]]
      item "classify - the apple account sheet"
        check
          source pane
          mode text
          name apple_sheet
          rect [0, 0, 1920, 1080]
          rect_at [1920, 1080]
          words [[sure, skip, signing]]
      item "classify - update"
        check
          source pane
          mode text
          name update
          rect [0, 0, 1920, 1080]
          rect_at [1920, 1080]
          words [[update, mac, automatically]]
      item "analytics - untick sharing first"
        if analytics
          then
            item "untick share analytics"
              input 808 513
              settle 3
            item "analytics continue"
              input 1306 810
              settle 10
      item "data and privacy"
        if privacy_pane
          then
            item "privacy continue"
              input 1306 810
              settle 8
      item "spoken languages"
        if languages
          then
            item "languages continue"
              input 1306 810
              settle 8
      item "accessibility"
        if accessibility
          then
            item "accessibility not now"
              input 1306 806
              settle 12
      item "transfer your data"
        if transfer
          then
            item "choose not to transfer"
              input 825 669
              settle 4
            item "transfer continue"
              input 1306 810
              settle 10
      item "country or region"
        if country
          then
            item "focus the country list"
              input 900 500
              settle 2
            item "type the country"
              input 900 500
              settle 1
            item "country text"
              settle 3
              input text "united states"
            item "country continue"
              input 1306 810
              settle 8
      item "the account, which is what this whole stage exists for"
        if account
          then
            item "account user name"
              input 945 447
              settle 2
            item "account user text"
              settle 3
              input text "{{ user }}"
            item "account password"
              input 850 531
              settle 2
            item "account password text"
              settle 3
              input text "{{ password }}"
            item "account verify"
              input 1086 531
              settle 2
            item "account verify text"
              settle 3
              input text "{{ password }}"
            item "account continue"
              input 1306 810
              settle 180
      item "location services"
        if location
          then
            item "location continue"
              input 1306 810
              settle 6
            item "dont use focus"
              input 960 632
              settle 3
            item "dont use confirm"
              input ret
              settle 6
      item "screen time"
        if screen_time
          then
            item "screen time later"
              input 619 806
              settle 8
      item "time zone"
        if time_zone
          then
            item "time zone continue"
              input 1306 806
              settle 10
      item "choose your look"
        if look
          then
            item "look continue"
              input 1306 805
              settle 12
      item "terms and conditions"
        if terms
          then
            item "terms agree"
              input 1298 806
              settle 8
            item "licence agree"
              input 1019 616
              settle 10
      item "welcome to mac"
        if welcome
          then
            item "welcome continue"
              input 960 990
              settle 12
      item "the keyboard assistant, which eats the next keystroke"
        if keyboard
          then
            item "keyboard continue"
              input 1222 818
              settle 12
      item "apple account - set up later"
        if apple_account
          then
            item "apple account later"
              input 619 806
              settle 10
      item "the apple account confirmation sheet"
        if apple_sheet
          then
            item "skip the apple account"
              input 1018 641
              settle 10
      item "update mac automatically"
        if update
          then
            item "update continue"
              input 1306 810
              settle 15
      item
        settle 2
      item "read the screen"
        read
          name wizard
    until
      bind finished
      source wizard
      mode text
      rect [31, 0, 119, 40]
      rect_at [1920, 1080]
      without [continue, back, later]
      words [finder]
    max 40


step "dismiss anything over the login window"
  input esc
  settle 2


step "click the password field"
  input 965 981
  settle 2


step "type the password"
  settle 2
  input text "{{ password }}"


step "press return"
  input ret
  settle 20


step "dismiss the overlays macOS puts up on a first login"
  do
    item
      input 1228 826
      settle 4
    item
      input 1228 826
      settle 4
    item
      input 1228 826
      settle 4
    item
      input esc
      settle 2
    item
      input meta_l+q
      settle 2
    item
      input esc
      settle 2


step "wait for the desktop"
  repeat
    do
      item
        settle 10
      item
        input esc
      item
        settle 2
      item "read the screen"
        read
          name desk
    until
      bind ready
      source desk
      mode text
      rect [31, 0, 119, 40]
      rect_at [1920, 1080]
      without [continue, back, later]
      words [finder]
    max 30


step "dismiss anything over the desktop"
  input esc
  settle 2


step "open spotlight"
  input meta_l+spc
  settle 4


step "type the settings app name"
  settle 7
  input text "system settings"


step "open it"
  input ret
  settle 14


step "the settings window is up"
  repeat
    do
      item
        settle 3
      item "read the screen"
        read
          name screen
    until
      bind done
      source screen
      mode text
      rect [590, 290, 1350, 690]
      rect_at [1920, 1080]
      words [[system, settings], [general], [wi-fi]]
    max 30

  # THE STEP IS CALLED "the remote login RESULT", AND IT WAS WAITING FOR THE PANEL'S CONTENTS.
  #
  # MEASURED ON RUN 44346450614, which failed after 45 attempts at step 16 of 31:
  #
  #	status: failed step 16/31 "the remote login result is on screen"
  #	error:  the loop ran 45 attempt(s) and the condition never held
  #
  # THE FRAME IS THE SEARCH RESULT, NOT THE PANE: System Settings with `remote login` typed in the
  # search field and a `Remote login` row under Sharing in the sidebar. The words the check wanted -
  # "allow full disk access", which only the PANE shows - appear after the NEXT step clicks that row,
  # and the next step was never reached because this one never passed.
  #
  # SO IT WAITS FOR THE ROW IT ACTUALLY NEEDS, which is the thing the click after it aims at.

step "search for remote login - click the field"
  input 715 267


step "search for remote login - select what is there"
  input ctrl+a
  settle 1


step "search for remote login - delete the selection"
  input backspace
  settle 1


step "search for remote login - type the value"
  input text "remote login"
    modifier meta_l
  settle 10

step "the remote login result is on screen"
  repeat
    do
      item
        settle 2
      item "read the screen"
        read
          name screen
    until
      bind done
      source screen
      mode text
      rect [622, 304, 748, 365]
      rect_at [1920, 1080]
      scale 2
      words [[remote, login]]
    max 45


step "open the remote login pane"
  input 703 336
  settle 12


step "open the remote login pane again"
  input 703 336
  rect [726, 300, 1200, 715]
  rect_at [1920, 1080]
  scale 2
  settle 12
  when_not [allow, full, disk, access]


step "the remote login pane is up"
  repeat
    do
      item
        settle 3
      item "read the screen"
        read
          name screen
    until
      bind done
      source screen
      mode text
      rect [731, 395, 907, 453]
      rect_at [1920, 1080]
      words [[allow, full, disk, access]]
    max 30


step "turn remote login on"
  input 1145 353
  rect [726, 300, 1200, 715]
  rect_at [1920, 1080]
  scale 2
  settle 4
  when_not [log, in, to, this, computer]


step "the switch reads on"
  repeat
    do
      item
        settle 3
      item "read the screen"
        read
          name screen
    until
      bind done
      source screen
      mode text
      rect [787, 336, 953, 395]
      rect_at [1920, 1080]
      words [[log, in, to, this, computer]]
    max 10


step "close the pane"
  input 1145 679
  settle 5


step "wait for sshd"
  repeat
    until machine_ssh
    max 60
    pause 10


step "prove the build over ssh"
  ssh "sw_vers -productVersion"


step "prove the account over ssh"
  ssh "id -un"


step "prove disk utility works over ssh"
  ssh "diskutil list | head -5"


step "name the machine"
  ssh "printf '%s\\n' \"{{ password }}\" | sudo -S scutil --set LocalHostName {{ user }}"


step "note what is absent"
  ssh "command -v brew || true"


# THE SLEEP IMAGE AND THE LOCAL SNAPSHOTS WERE DELETED HERE, AND THIS STAGE NO LONGER DOES THAT.
#
# THEY WERE REMOVED TO SHRINK A DIFF THAT COULD NOT BE SHRUNK: the step's own measurement was
#
#	/dev/disk2s4s1   128Gi    22Gi    87Gi    21%    426k  915M    0%    /
#
# - the guest freed the files and the host diff did not get one byte of it back, because APFS does not
# hand deletes to `discard=unmap` while it runs. THE STEP WAS THEREFORE CORRECT AND USELESS AT THE SAME
# TIME, and the disk it wanted to shrink only existed because this file had `overlay false`.
#
# WITH A DIFF AND NO `overlay false` THERE IS NOTHING TO SHRINK: the base is read-only, the diff holds
# what the guest wrote, and `publish` flattens the two. MACOS 26 HAS NEVER HAD THIS STEP, HAS ALWAYS
# USED A DIFF, AND PUBLISHES 16407 MiB - 18 GiB LESS THAN THIS FILE PUBLISHED WITH ITS CLEANUP.
#
# Deleting files from a user's system to make a runner fit is worth doing only when it works. Here it
# did not, and the thing it was compensating for is gone.


  # `shutdown: ssh` RATHER THAN A HAND-WRITTEN `poweroff`, BECAUSE THE HAND-WRITTEN ONE CANNOT WIN.
  #
  # MEASURED ON RUN 44450353655, step 29 of 31 - the step before the last:
  #
  #	status: failed step 29/31 "ask the guest to power off"
  #	error:   ask the guest to power off: the command exited 1
  #
  # AND THE LOG ENDS AT `Password:`: `poweroff` closed the connection the command was being read
  # over, so ssh saw EOF and reported 1 for the shutdown that had just worked. There is no exit code
  # a successful `poweroff` over ssh can return - the session dies with the machine.
  #
  # `macos/26/steps/ssh.walk` HAD THIS RIGHT ALL ALONG with `shutdown: ssh`, which is the method that
  # sends the command AND tolerates the connection ending. This file now uses it too, and the
  # `wait_until: stopped` after it is what actually confirms the machine went down.

step "stop the machine"
  stop ssh
  timeout 300


step "wait for the machine to stop"
  wait_until stopped
  timeout 300


step "publish the disk"
    save "{{ out }}"
