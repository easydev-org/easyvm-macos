walkthrough "macos 15 ssh - the setup assistant, remote login, and a graceful shutdown"
resolution 1920x1080
recording_resolution 1920x1080
user vmuser
var out
  default out/macos15-ssh.qcow2
  from args.out
password admin
var user
  default vmuser
  from args.user
boot_disk from_caller
ssh_port 2222


step "the media this stage boots from is already on disk"
  needs [boot.img, macos.rom, macos.vars]


step "boot the disk"
  boot
    machine "q35,accel=kvm,vmport=off"
    # THE WRITES GO STRAIGHT TO THE DISK, BECAUSE THREE COPIES DO NOT FIT AND ONE OF THEM WAS GARBAGE.
    #
    # `publish` reads the disk AND its diff and writes a THIRD file, so the peak is the sum of three.
    # MEASURED on run 45611579655, which passed all 36 steps and died in `publish the disk`:
    #
    #	disk.qcow2          27.95 GiB   the pulled system, read-only
    #	run-overlay.qcow2   26.29 GiB   what the guest wrote
    #	qemu-img convert    42.2 GiB    where the compressed flatten ran out of room
    #	                    ---------
    #	                    ~96 GiB     on an 84 GiB runner
    #
    # AND THE GUEST'S OWN `df -h /` IN THAT RUN SAID 22 GiB USED. The 26 GiB diff was almost entirely
    # blocks the guest had already freed: APFS does not hand deletes back to `discard=unmap` while it
    # runs, so nothing could shrink it, and the third copy had nowhere to go. Removing the sleep
    # image, the swapfiles and the local snapshots inside the guest freed nothing on the host - that
    # is measured too, in the step that does it.
    #
    # WITH NO DIFF THERE IS NO SECOND COPY: the peak becomes the disk plus its output, about 70 GiB.
    #
    # WHAT IT GIVES UP, AND WHY THAT IS ACCEPTABLE HERE: a diff is what lets a failed run leave the
    # published disk untouched, and what makes a guest's TRIM safe. This stage's writes ARE its
    # product - it is the stage that turns on Remote Login - and nothing after it reads the bytes it
    # frees. The `discard=unmap` below now reaches the real disk, which is the point: the blocks the
    # guest gave back are gone from the file publish has to copy.
    overlay false
    args [["-m", "12288"], ["-cpu", "Skylake-Client-v4,vendor=GenuineIntel,vmx=off,vmware-cpuid-freq=on,-pdpe1gb,+invtsc,+ssse3,+sse4.2,+popcnt,+avx,+avx2,+aes,+fma,+bmi1,+bmi2,+smep,+xsave,+xsaveopt,+xgetbv1,+movbe,+rdrand,check"], ["-smp", "4,sockets=1,dies=1,cores=4,threads=1"], ["-drive", "if=pflash,format=raw,readonly=on,file=macos.rom"], ["-drive", "if=pflash,format=raw,file=macos.vars"], ["-drive", "file=boot.img,format=raw,if=none,id=oc"], ["-device", "virtio-blk-pci,drive=oc,bootindex=0"], ["-chardev", "socket,id=qga0,path=qga.sock,server=on,wait=off"], ["-device", "isa-serial,chardev=qga0"], ["-device", "qemu-xhci,id=xhci"], ["-device", "usb-tablet,bus=xhci.0"], ["-device", "usb-kbd,bus=xhci.0"], ["-drive", "file=disk.qcow2,if=none,format=qcow2,discard=unmap,id=target"], ["-device", "virtio-blk-pci,drive=target,bootindex=1"], ["-global", "ICH9-LPC.disable_s3=1"], ["-global", "ICH9-LPC.disable_s4=1"], ["-global", "ICH9-LPC.acpi-pci-hotplug-with-bridge-support=off"], ["-rtc", "base=utc"], ["-smbios", "type=2"], ["-device", "vmware-svga"], ["-audiodev", "none,id=snd0"], ["-device", "usb-audio,bus=xhci.0,audiodev=snd0"], ["-device", "isa-applesmc,osk=ourhardworkbythesewordsguardedpleasedontsteal(c)AppleComputerInc"], ["-netdev", "tap,id=net0,ifname=qemutap0,script=no,downscript=no"], ["-device", "virtio-net-pci,netdev=net0,mac=52:54:00:56:4d:01,romfile=,host_mtu=1450"]]
    timeout 900
step "answer the wizard until the desktop appears"
  repeat
    do
      item "read the pane"
        read
          name pane
      item "classify - analytics"
        check
          source pane
          mode text
          name analytics
          rect [0, 0, 1920, 1080]
          rect_at [1920, 1080]
          words [analytics, improve]
      item "classify - data and privacy"
        check
          source pane
          mode text
          name privacy_pane
          rect [0, 0, 1920, 1080]
          rect_at [1920, 1080]
          words [privacy, fundamental]
      item "classify - spoken languages"
        check
          source pane
          mode text
          name languages
          rect [0, 0, 1920, 1080]
          rect_at [1920, 1080]
          words [spoken, languages]
      item "classify - accessibility"
        check
          source pane
          mode text
          name accessibility
          rect [0, 0, 1920, 1080]
          rect_at [1920, 1080]
          words [accessibility, individual]
      item "classify - transfer"
        check
          source pane
          mode text
          name transfer
          rect [0, 0, 1920, 1080]
          rect_at [1920, 1080]
          words [transfer, data]
      item "classify - country"
        check
          source pane
          mode text
          name country
          rect [0, 0, 1920, 1080]
          rect_at [1920, 1080]
          words [country, region]
      item "classify - account"
        check
          source pane
          mode text
          name account
          rect [0, 0, 1920, 1080]
          rect_at [1920, 1080]
          words [create, mac, account]
      item "classify - location"
        check
          source pane
          mode text
          name location
          rect [0, 0, 1920, 1080]
          rect_at [1920, 1080]
          words [approximate, location]
      item "classify - screen time"
        check
          source pane
          mode text
          name screen_time
          rect [0, 0, 1920, 1080]
          rect_at [1920, 1080]
          words [screen, report]
      item "classify - time zone"
        check
          source pane
          mode text
          name time_zone
          rect [0, 0, 1920, 1080]
          rect_at [1920, 1080]
          words [time, zone]
      item "classify - look"
        check
          source pane
          mode text
          name look
          rect [0, 0, 1920, 1080]
          rect_at [1920, 1080]
          words [look, appearance]
      item "classify - terms"
        check
          source pane
          mode text
          name terms
          rect [0, 0, 1920, 1080]
          rect_at [1920, 1080]
          words [terms, conditions]
      item "classify - welcome"
        check
          source pane
          mode text
          name welcome
          rect [0, 0, 1920, 1080]
          rect_at [1920, 1080]
          words [welcome, mac]
      item "classify - keyboard"
        check
          source pane
          mode text
          name keyboard
          rect [0, 0, 1920, 1080]
          rect_at [1920, 1080]
          words [keyboard, assistant]
      item "classify - apple account"
        check
          source pane
          mode text
          name apple_account
          rect [0, 0, 1920, 1080]
          rect_at [1920, 1080]
          words [sign, in, to, your, apple, account]
      item "classify - the apple account sheet"
        check
          source pane
          mode text
          name apple_sheet
          rect [0, 0, 1920, 1080]
          rect_at [1920, 1080]
          words [are, you, sure]
      item "classify - update"
        check
          source pane
          mode text
          name update
          rect [0, 0, 1920, 1080]
          rect_at [1920, 1080]
          words [update, automatically]
      item "analytics - untick sharing first"
        if analytics
          then
            item "untick share analytics"
              input 808 513
              settle 3
            item "analytics continue"
              input 1306 810
              settle 10
      item "data and privacy"
        if privacy_pane
          then
            item "privacy continue"
              input 1306 810
              settle 8
      item "spoken languages"
        if languages
          then
            item "languages continue"
              input 1306 810
              settle 8
      item "accessibility"
        if accessibility
          then
            item "accessibility not now"
              input 1306 806
              settle 12
      item "transfer your data"
        if transfer
          then
            item "choose not to transfer"
              input 825 669
              settle 4
            item "transfer continue"
              input 1306 810
              settle 10
      item "country or region"
        if country
          then
            item "focus the country list"
              input 900 500
              settle 2
            item "type the country"
              input 900 500
              settle 1
            item "country text"
              settle 3
              input text "united states"
            item "country continue"
              input 1306 810
              settle 8
      item "the account, which is what this whole stage exists for"
        if account
          then
            item "account user name"
              input 945 447
              settle 2
            item "account user text"
              settle 3
              input text "{{ user }}"
            item "account password"
              input 850 531
              settle 2
            item "account password text"
              settle 3
              input text "{{ password }}"
            item "account verify"
              input 1086 531
              settle 2
            item "account verify text"
              settle 3
              input text "{{ password }}"
            item "account continue"
              input 1306 810
              settle 180
      item "location services"
        if location
          then
            item "location continue"
              input 1306 810
              settle 6
            item "dont use focus"
              input 960 632
              settle 3
            item "dont use confirm"
              input ret
              settle 6
      item "screen time"
        if screen_time
          then
            item "screen time later"
              input 619 806
              settle 8
      item "time zone"
        if time_zone
          then
            item "time zone continue"
              input 1306 806
              settle 10
      item "choose your look"
        if look
          then
            item "look continue"
              input 1306 805
              settle 12
      item "terms and conditions"
        if terms
          then
            item "terms agree"
              input 1298 806
              settle 8
            item "licence agree"
              input 1019 616
              settle 10
      item "welcome to mac"
        if welcome
          then
            item "welcome continue"
              input 960 990
              settle 12
      item "the keyboard assistant, which eats the next keystroke"
        if keyboard
          then
            item "keyboard continue"
              input 1222 818
              settle 12
      item "apple account - set up later"
        if apple_account
          then
            item "apple account later"
              input 619 806
              settle 10
      item "the apple account confirmation sheet"
        if apple_sheet
          then
            item "skip the apple account"
              input 1018 641
              settle 10
      item "update mac automatically"
        if update
          then
            item "update continue"
              input 1306 810
              settle 15
      item
        settle 2
      item "read the screen"
        read
          name wizard
    until
      bind finished
      source wizard
      mode text
      rect [31, 0, 119, 40]
      rect_at [1920, 1080]
      without [continue, back, later]
      words [finder]
    max 40


step "dismiss anything over the login window"
  input esc
  settle 2


step "click the password field"
  input 965 981
  settle 2


step "type the password"
  settle 2
  input text "{{ password }}"


step "press return"
  input ret
  settle 20


step "dismiss the overlays macOS puts up on a first login"
  do
    item
      input 1228 826
      settle 4
    item
      input 1228 826
      settle 4
    item
      input 1228 826
      settle 4
    item
      input esc
      settle 2
    item
      input meta_l+q
      settle 2
    item
      input esc
      settle 2


step "wait for the desktop"
  repeat
    do
      item
        settle 10
      item
        input esc
      item
        settle 2
      item "read the screen"
        read
          name desk
    until
      bind ready
      source desk
      mode text
      rect [31, 0, 119, 40]
      rect_at [1920, 1080]
      without [continue, back, later]
      words [finder]
    max 30


step "dismiss anything over the desktop"
  input esc
  settle 2


step "open spotlight"
  input meta_l+spc
  settle 4


step "type the settings app name"
  settle 7
  input text "system settings"


step "open it"
  input ret
  settle 14


step "the settings window is up"
  repeat
    do
      item
        settle 3
      item "read the screen"
        read
          name screen
    until
      bind done
      source screen
      mode text
      rect [590, 290, 1350, 690]
      rect_at [1920, 1080]
      words [[system, settings], [general], [wi-fi]]
    max 30

  # THE STEP IS CALLED "the remote login RESULT", AND IT WAS WAITING FOR THE PANEL'S CONTENTS.
  #
  # MEASURED ON RUN 44346450614, which failed after 45 attempts at step 16 of 31:
  #
  #	status: failed step 16/31 "the remote login result is on screen"
  #	error:  the loop ran 45 attempt(s) and the condition never held
  #
  # THE FRAME IS THE SEARCH RESULT, NOT THE PANE: System Settings with `remote login` typed in the
  # search field and a `Remote login` row under Sharing in the sidebar. The words the check wanted -
  # "allow full disk access", which only the PANE shows - appear after the NEXT step clicks that row,
  # and the next step was never reached because this one never passed.
  #
  # SO IT WAITS FOR THE ROW IT ACTUALLY NEEDS, which is the thing the click after it aims at.

step "search for remote login - click the field"
  input 715 267


step "search for remote login - select what is there"
  input ctrl+a
  settle 1


step "search for remote login - delete the selection"
  input backspace
  settle 1


step "search for remote login - type the value"
  input text "remote login"
    modifier meta_l
  settle 10

step "the remote login result is on screen"
  repeat
    do
      item
        settle 2
      item "read the screen"
        read
          name screen
    until
      bind done
      source screen
      mode text
      rect [622, 304, 748, 365]
      rect_at [1920, 1080]
      scale 2
      words [[remote, login]]
    max 45


step "open the remote login pane"
  input 703 336
  settle 12


step "open the remote login pane again"
  input 703 336
  rect [726, 300, 1200, 715]
  rect_at [1920, 1080]
  scale 2
  settle 12
  when_not [allow, full, disk, access]


step "the remote login pane is up"
  repeat
    do
      item
        settle 3
      item "read the screen"
        read
          name screen
    until
      bind done
      source screen
      mode text
      rect [731, 395, 907, 453]
      rect_at [1920, 1080]
      words [[allow, full, disk, access]]
    max 30


step "turn remote login on"
  input 1145 353
  rect [726, 300, 1200, 715]
  rect_at [1920, 1080]
  scale 2
  settle 4
  when_not [log, in, to, this, computer]


step "the switch reads on"
  repeat
    do
      item
        settle 3
      item "read the screen"
        read
          name screen
    until
      bind done
      source screen
      mode text
      rect [787, 336, 953, 395]
      rect_at [1920, 1080]
      words [[log, in, to, this, computer]]
    max 10


step "close the pane"
  input 1145 679
  settle 5


step "wait for sshd"
  repeat
    until machine_ssh
    max 60
    pause 10


step "prove the build over ssh"
  ssh "sw_vers -productVersion"


step "prove the account over ssh"
  ssh "id -un"


step "prove disk utility works over ssh"
  ssh "diskutil list | head -5"


step "name the machine"
  ssh "printf '%s\\n' \"{{ password }}\" | sudo -S scutil --set LocalHostName {{ user }}"


step "note what is absent"
  ssh "command -v brew || true"


# THE DISK THIS STAGE HANDS ON MUST FIT IN THE RUNNER THAT IS WRITING IT, AND IT DID NOT.
#
# MEASURED on run 45600395447, which passed all 34 steps and then died in `publish the disk`:
#
#	qemu-img convert: error while writing at byte 43931992064: No space left on device
#
# Its own directory listing at that moment, and the arithmetic the whole fix follows from:
#
#	disk.qcow2          28620 MiB   27.9 GiB   the pulled system, the read-only backing
#	run-overlay.qcow2   25243 MiB   24.7 GiB   what the guest wrote
#	publish target                 40.9 GiB   where the flatten stopped writing
#	                               --------
#	                              ~93.5 GiB    on an 84 GiB runner
#
# SO THE OVERLAY HAS TO COME DOWN TO ~15 GiB for the three to fit at once. THE SLEEP IMAGE ALONE IS
# ABOUT HALF OF IT: it is written at hibernatemode 3 with a size near the guest's RAM, which is
# 12288 MiB on this machine. The rest is the boot snapshot and the caches a first macOS boot writes.
#
# `discard=unmap` IS ALREADY ON THE DISK'S `-drive` LINE, so a DELETE INSIDE THE GUEST HANDS THE
# CLUSTERS BACK and the overlay on the host shrinks - it is not merely free space the guest can
# reuse afterwards.
#
# WHAT IS REMOVED AND WHY IT IS SAFE:
#
#	sleepimage        this image offers no hibernation, `vm-configure` turns sleeping off entirely,
#	                  and macOS recreates the file if it ever wants one
#	local snapshots   Time Machine's local snapshots are purgeable by definition; no stage reads one
#	                  and `tmutil` skips them by time, so anything it will not delete it reports
#	swapfiles         matched to the guest's RAM and recreated on demand; removing them is what
#	                  `dynamic_pager` is for, and `swapoff -a` is not needed for a file to be re-edged
#
# `df -h /` IS PRINTED BY THE STEP ITSELF so the next run's log says whether it worked, instead of
# leaving the next person to infer it from a qemu-img error forty minutes later.
step "give the overlay back the space the guest spent"
  ssh "printf '%s\\n' \"{{ password }}\" | sudo -S -p '' sh -c 'rm -f /private/var/vm/sleepimage; rm -f /private/var/vm/swapfile*; for s in $(tmutil listlocalsnapshots / 2>/dev/null | sed -n \"s/^com\\.apple\\.TimeMachine.*\\.\\(.*\\)$/\\1/p\"); do tmutil deletelocalsnapshots \"$s\" 2>/dev/null; done; sync; df -h / | tail -1'"
  timeout 300


step "say how much room the guest has left"
  ssh "df -h / | tail -1"
  timeout 60

  # `shutdown: ssh` RATHER THAN A HAND-WRITTEN `poweroff`, BECAUSE THE HAND-WRITTEN ONE CANNOT WIN.
  #
  # MEASURED ON RUN 44450353655, step 29 of 31 - the step before the last:
  #
  #	status: failed step 29/31 "ask the guest to power off"
  #	error:   ask the guest to power off: the command exited 1
  #
  # AND THE LOG ENDS AT `Password:`: `poweroff` closed the connection the command was being read
  # over, so ssh saw EOF and reported 1 for the shutdown that had just worked. There is no exit code
  # a successful `poweroff` over ssh can return - the session dies with the machine.
  #
  # `macos/26/steps/ssh.walk` HAD THIS RIGHT ALL ALONG with `shutdown: ssh`, which is the method that
  # sends the command AND tolerates the connection ending. This file now uses it too, and the
  # `wait_until: stopped` after it is what actually confirms the machine went down.

step "stop the machine"
  stop ssh
  timeout 300


step "wait for the machine to stop"
  wait_until stopped
  timeout 300


step "publish the disk"
    save "{{ out }}"
