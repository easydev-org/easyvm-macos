walkthrough "macos 15 ssh - the setup assistant, remote login, and a graceful shutdown"
resolution 1920x1080
recording_resolution 1920x1080
user vmuser
var out
  default out/macos15-ssh.qcow2
  from args.out
password admin
var user
  default vmuser
  from args.user
boot_disk from_caller
ssh_port 2222


step "the media this stage boots from is already on disk"
  needs [boot.img, macos.rom, macos.vars]


step "boot the disk"
  boot
    machine "q35,accel=kvm,vmport=off"
    # THE WRITES GO TO A THROWAWAY DIFF, LIKE EVERY OTHER STAGE HERE.
    #
    # THIS FILE USED `overlay false`, AND THE PUBLISHED DISK PAID FOR IT. MEASURED, the same two stages
    # side by side:
    #
    #	             boot                 base before   base after   published
    #	macos 15     overlay false        28620 MiB     40981 MiB    34589 MiB
    #	macos 26     diff over the base   33618 MiB     33618 MiB    16407 MiB
    #
    # MACOS 26'S BASE IS 5 GiB LARGER AND ITS PRODUCT IS 18 GiB SMALLER, because with a diff the base
    # is never written and the published file is the compressed flatten of a diff that holds only what
    # the guest actually added. With `overlay false` every write lands in the base, `discard=unmap`
    # reaches the base, and the file that gets compressed is 41 GiB of mostly-free space.
    #
    # THE REASON IT WAS TURNED OFF WAS A PEAK, NOT A RESULT: at the time this stage published 42.2 GiB
    # of output and the base plus a live diff plus that output did not fit in 84 GiB. THAT PEAK IS GONE
    # FOR A REASON THAT HAS NOTHING TO DO WITH OVERLAYS: the recording now ends before `publish`, and a
    # diff that is 12 GiB smaller than the growth this file used to cause leaves the same three files
    # comfortably inside the runner. Measured on macos 26, which has always used a diff and has never
    # needed the room this file gave up its guarantees for.
    #
    # WHAT COMES BACK WITH THE DIFF: a failed run leaves the published disk untouched, and the guest's
    # TRIM cannot reach the base. Both were given away here for a peak that no longer exists.
    args [["-m", "12288"], ["-cpu", "Skylake-Client-v4,vendor=GenuineIntel,vmx=off,vmware-cpuid-freq=on,-pdpe1gb,+invtsc,+ssse3,+sse4.2,+popcnt,+avx,+avx2,+aes,+fma,+bmi1,+bmi2,+smep,+xsave,+xsaveopt,+xgetbv1,+movbe,+rdrand,check"], ["-smp", "4,sockets=1,dies=1,cores=4,threads=1"], ["-drive", "if=pflash,format=raw,readonly=on,file=macos.rom"], ["-drive", "if=pflash,format=raw,file=macos.vars"], ["-drive", "file=boot.img,format=raw,if=none,id=oc"], ["-device", "virtio-blk-pci,drive=oc,bootindex=0"], ["-chardev", "socket,id=qga0,path=qga.sock,server=on,wait=off"], ["-device", "isa-serial,chardev=qga0"], ["-device", "qemu-xhci,id=xhci"], ["-device", "usb-tablet,bus=xhci.0"], ["-device", "usb-kbd,bus=xhci.0"], ["-drive", "file=disk.qcow2,if=none,format=qcow2,discard=unmap,id=target"], ["-device", "virtio-blk-pci,drive=target,bootindex=1"], ["-global", "ICH9-LPC.disable_s3=1"], ["-global", "ICH9-LPC.disable_s4=1"], ["-global", "ICH9-LPC.acpi-pci-hotplug-with-bridge-support=off"], ["-rtc", "base=utc"], ["-smbios", "type=2"], ["-device", "vmware-svga"], ["-audiodev", "none,id=snd0"], ["-device", "usb-audio,bus=xhci.0,audiodev=snd0"], ["-device", "isa-applesmc,osk=ourhardworkbythesewordsguardedpleasedontsteal(c)AppleComputerInc"], ["-netdev", "tap,id=net0,ifname=qemutap0,script=no,downscript=no"], ["-device", "virtio-net-pci,netdev=net0,mac=52:54:00:56:4d:01,romfile=,host_mtu=1450"]]
    timeout 900
# THE WIZARD IS A FIXED SEQUENCE, SO IT IS WRITTEN AS ONE - ONE PAGE PER STEP, NO LOOP.
#
# MEASURED TWICE FROM THE RECORDINGS (run 45773302724 and run 45791461278). The panes arrive in the
# same order on both, every time:
#
#	country -> transfer -> languages -> accessibility -> data & privacy -> account ->
#	apple sheet -> terms -> location -> time zone -> analytics -> screen time -> look -> update
#
# THE LOOP THIS REPLACES RE-READ THE SCREEN AND RE-ASKED ALL SEVENTEEN CHECKS ON EVERY PASS, and each
# check was a full OCR of a 1920x1080 frame. A linear sequence of fourteen panes cost thirty to seventy
# minutes depending on how many passes it needed. A sequence has no such cost: each page is waited for
# once, answered once, and the next page is waited for.
#
# WHY THE ORDER IS RELIABLE ENOUGH TO WRITE DOWN. The loop existed because the Setup Assistant was
# assumed to be unpredictable. The recordings say otherwise: run 45791461278 crossed thirteen panes in
# nineteen rounds, every one a NEW pane, with none visited twice.
#
# EACH PAGE IS TWO STEPS, BECAUSE A STEP DOES ONE THING: one waits for the pane's own title, the next
# answers it. A page that never arrives fails in its waiting step, naming the title it wanted - where
# the loop would have re-tried it silently until its cap, which is how run 45773302724 spent 66
# minutes on one pane.

# THE FIRST PAGE TAKES MINUTES, NOT SECONDS: the guest is still booting when this step starts, and
# macOS spends two to five minutes in the boot before the Setup Assistant draws anything.
#
# MEASURED on the local probe: `boot:` returns as soon as qemu is up (412 ms), and the frame two
# seconds later is still black. A `settle` here has to cover the whole boot, because the page it is
# waiting for cannot appear until the boot is done.
step "wait for the country or region page"
  repeat
    do
      item "read the screen"
        read
          name pane
    until
      bind up
      source pane
      mode text
      rect [0, 0, 1920, 1080]
      rect_at [1920, 1080]
      scale 1
      words [[select, your, country, or, region]]
    # 2s between reads: the engine's own default, said out loud.
    pause 2
    max 90

step "answer the country or region page"
  do
    item
      input 900 500
      settle 2
    item
      input text "united states"
      settle 4
    item
      input 1306 810
      settle 10

step "wait for the transfer page"
  repeat
    do
      item "read the screen"
        read
          name pane
    until
      bind up
      source pane
      mode text
      rect [0, 0, 1920, 1080]
      rect_at [1920, 1080]
      scale 1
      words [[transfer, your, information, to, this, mac]]
    # 2s between reads: the engine's own default, said out loud.
    pause 2
    max 45

step "answer the transfer page"
  do
    item
      input 825 669
      settle 4
    item
      input 1306 810
      settle 10

step "wait for the spoken languages page"
  repeat
    do
      item "read the screen"
        read
          name pane
    until
      bind up
      source pane
      mode text
      rect [0, 0, 1920, 1080]
      rect_at [1920, 1080]
      scale 1
      words [[spoken, languages]]
    # 2s between reads: the engine's own default, said out loud.
    pause 2
    max 45

step "answer the spoken languages page"
  do
    item
      input 1306 810
      settle 10

step "wait for the accessibility page"
  repeat
    do
      item "read the screen"
        read
          name pane
    until
      bind up
      source pane
      mode text
      rect [0, 0, 1920, 1080]
      rect_at [1920, 1080]
      scale 1
      words [[accessibility, individual]]
    # 2s between reads: the engine's own default, said out loud.
    pause 2
    max 45

step "answer the accessibility page"
  do
    item
      input 1306 806
      settle 12

step "wait for the data and privacy page"
  repeat
    do
      item "read the screen"
        read
          name pane
    until
      bind up
      source pane
      mode text
      rect [0, 0, 1920, 1080]
      rect_at [1920, 1080]
      scale 1
      words [[privacy, fundamental]]
    # 2s between reads: the engine's own default, said out loud.
    pause 2
    max 45

step "answer the data and privacy page"
  do
    item
      input 1306 810
      settle 10

step "wait for the create a mac account page"
  repeat
    do
      item "read the screen"
        read
          name pane
    until
      bind up
      source pane
      mode text
      rect [0, 0, 1920, 1080]
      rect_at [1920, 1080]
      scale 1
      words [[create, a, mac, account, here]]
    # 2s between reads: the engine's own default, said out loud.
    pause 2
    max 60

# THE SETTLE GOES BEFORE THE TEXT, NOT AFTER IT. MEASURED on the local run at step 14/61: the frame
# after this step showed "Create a Mac Account" with the Full name field FOCUSED AND EMPTY - the click
# had landed and the typing had not. The loop this replaced wrote it the other way round:
#
#	item "account user text"
#	  settle 3            <- wait for the click's focus to take
#	  input text "..."
#
# so the field was given three seconds to become the keyboard's target before any key was sent. Here
# the settle was on the far side, and the keys went to a window that had not taken focus yet.
step "answer the create a mac account page"
  do
    item
      input 945 447
      settle 5
    item
      settle 3
      input text "{{ user }}"
    item
      settle 2
    item
      input 850 531
      settle 5
    item
      settle 3
      input text "{{ password }}"
    item
      settle 2
    item
      input 1086 531
      settle 5
    item
      settle 3
      input text "{{ password }}"
    item
      settle 3
    item
      input 1306 810
      settle 180

# SKIPPING THE APPLE ACCOUNT IS TWO CLICKS, AND THE FIRST ONE WAS MISSING.
#
# MEASURED across runs 4 and 5. The pane "Sign In to Your Apple Account" has its way out at the
# BOTTOM LEFT - `Set Up Later` at (615, 808) - and clicking it raises a SECOND sheet:
#
#	Are you sure you want to skip signing in with an Apple Account?
#	[ Don't Skip ]   [ Skip ]
#
# The walk only had the second click (1018, 641). With no sheet on screen that click landed on the
# Sign In pane itself, and the sheet then appeared ON TOP OF EVERY LATER STEP: run 5's recording is
# that sheet from 13:08 to the end, with each subsequent click (migration assistant, login field,
# password, return) landing on it or behind it.
step "set the apple account up later"
  input 615 808
  settle 10


step "wait for the apple account confirmation sheet"
  repeat
    do
      item "read the screen"
        read
          name pane
    until
      bind up
      source pane
      mode text
      rect [0, 0, 1920, 1080]
      rect_at [1920, 1080]
      scale 1
      words [[sure, skip, signing]]
    # 2s between reads: the engine's own default, said out loud.
    pause 2
    max 45

step "answer the apple account confirmation sheet"
  do
    item
      input 1018 641
      settle 10

step "wait for the terms and conditions page"
  repeat
    do
      item "read the screen"
        read
          name pane
    until
      bind up
      source pane
      mode text
      rect [0, 0, 1920, 1080]
      rect_at [1920, 1080]
      scale 1
      words [[terms, conditions]]
    # 2s between reads: the engine's own default, said out loud.
    pause 2
    max 45

step "answer the terms and conditions page"
  do
    item
      input 1298 806
      settle 8
    item
      input 1019 616
      settle 10

step "wait for the location services page"
  repeat
    do
      item "read the screen"
        read
          name pane
    until
      bind up
      source pane
      mode text
      rect [0, 0, 1920, 1080]
      rect_at [1920, 1080]
      scale 1
      words [[enable, location, services]]
    # 2s between reads: the engine's own default, said out loud.
    pause 2
    max 45

step "answer the location services page"
  do
    item
      input 1306 810
      settle 6
    item
      input 960 632
      settle 3
    item
      input ret
      settle 6

step "wait for the time zone page"
  repeat
    do
      item "read the screen"
        read
          name pane
    until
      bind up
      source pane
      mode text
      rect [0, 0, 1920, 1080]
      rect_at [1920, 1080]
      scale 1
      words [[time, zone]]
    # 2s between reads: the engine's own default, said out loud.
    pause 2
    max 45

step "answer the time zone page"
  do
    item
      input 1306 806
      settle 10

step "wait for the analytics page"
  repeat
    do
      item "read the screen"
        read
          name pane
    until
      bind up
      source pane
      mode text
      rect [0, 0, 1920, 1080]
      rect_at [1920, 1080]
      scale 1
      words [[share, analytics, with, apple]]
    # 2s between reads: the engine's own default, said out loud.
    pause 2
    max 45

step "answer the analytics page"
  do
    item
      input 808 513
      settle 3
    item
      input 1306 810
      settle 10

step "wait for the screen time page"
  repeat
    do
      item "read the screen"
        read
          name pane
    until
      bind up
      source pane
      mode text
      rect [0, 0, 1920, 1080]
      rect_at [1920, 1080]
      scale 1
      words [[screen, time]]
    # 2s between reads: the engine's own default, said out loud.
    pause 2
    max 45

step "answer the screen time page"
  do
    item
      input 619 806
      settle 8

step "wait for the choose your look page"
  repeat
    do
      item "read the screen"
        read
          name pane
    until
      bind up
      source pane
      mode text
      rect [0, 0, 1920, 1080]
      rect_at [1920, 1080]
      scale 1
      words [[choose, your, look]]
    # 2s between reads: the engine's own default, said out loud.
    pause 2
    max 45

step "answer the choose your look page"
  do
    item
      input 1299 810
      settle 12

step "wait for the update mac automatically page"
  repeat
    do
      item "read the screen"
        read
          name pane
    until
      bind up
      source pane
      mode text
      rect [0, 0, 1920, 1080]
      rect_at [1920, 1080]
      scale 1
      words [[update, mac, automatically]]
    # 2s between reads: the engine's own default, said out loud.
    pause 2
    max 60

step "answer the update mac automatically page"
  do
    item
      input 1306 810
      settle 15


# THE WIZARD HAS ONE MORE PAGE, AND IT IS THE ONE NOBODY EXPECTED: THE MIGRATION ASSISTANT.
#
# MEASURED from run 3's recording (t=960s), after `answer the update mac automatically page`:
#
#	Transfer information to this Mac
#	Select a Mac, Time Machine backup, or other startup disk to transfer its information to this Mac.
#	                       [mnt1  !]
#	                       Other Server...
#	Not now                                    [ Back ]  [ Continue ]
#
# AND ITS `mnt1` IS A WARNING: clicking it (or Continue) opens
#
#	The selected source cannot be used for migration.
#	Volume contains a macOS or OS X installation which may be damaged.
#	                                  [ OK ]
#
# The way past is `Not now` at the BOTTOM LEFT, which no other page in this wizard has - every earlier
# pane puts its forward control at the bottom right.
#
# WITHOUT THIS STEP THE WALK IS OFF BY ONE PANE FOR EVERYTHING AFTER IT: it pressed Escape and
# Command-Q while the wizard was still open, macOS answered with
#
#	Do you want to shut down your computer?
#	You haven't finished setting up macOS.
#	[ Cancel ]  [ Shut Down ]
#
# and the "software licence" step then clicked (1307,805) - the wizard's Continue - on a page that was
# not a licence at all.
step "skip the migration assistant"
  input 606 808
  settle 15





step "dismiss anything over the login window"
  input esc
  settle 2


step "click the password field"
  input 965 981
  settle 2


step "type the password"
  settle 2
  input text "{{ password }}"


step "press return"
  input ret
  settle 20


# NO `meta_l+q` HERE. It was in the loop this replaces, and MEASURED on run 3 it is the one keystroke
# that must not be sent blind: with the wizard still open, Command-Q raises
#
#	Do you want to shut down your computer?
#	You haven't finished setting up macOS.
#	[ Cancel ]  [ Shut Down ]
#
# which then swallows every later click. Escape closes the "what's new" and notification overlays and
# cannot shut the machine down, so the dismissal is Escape three times with a click on the empty
# desktop between them to take the focus away from any sheet.
step "dismiss the overlays macOS puts up on a first login"
  do
    item
      input esc
      settle 3
    item
      input 1228 826
      settle 3
    item
      input esc
      settle 3
    item
      input 1228 826
      settle 3
    item
      input esc
      settle 3


# THE SOFTWARE LICENCE COMES BACK AFTER THE FIRST LOGIN, AND IT BLOCKS THE DESKTOP.
#
# MEASURED on the local run at step 36/61: the frame during `wait for the desktop` is
#
#	Terms and Conditions
#	... PLEASE READ THIS SOFTWARE LICENSE AGREEMENT ...
#	                                          [ Back ]  [ Agree ]
#
# THE WIZARD'S OWN TERMS PAGE WAS ALREADY ANSWERED at step 18. THIS IS A SECOND, DIFFERENT ONE - the
# licence macOS shows to the first user who logs in - and nothing in the walk answered it, so the loop
# waited for a Finder menu behind a modal sheet that would never close.
#
# (1307, 805) IS MEASURED FROM THAT FRAME: the Agree button's centre in the 1920x1080 capture. The
# wizard's terms step uses (1298, 806), which is the same control on a differently laid-out page.
step "wait for the software licence the first login shows"
  # 30s, MEASURED: run 2's journal has the licence on screen by 12:12:40, which is immediately after
  # `dismiss the overlays` finishes (12:12:21 press return + 20s, then 19s of overlay clicks). The
  # settle covers the sheet's own animation on top of that.
  settle 30


step "accept the software licence the first login shows"
  input 1307 805
  settle 20


step "wait for the desktop"
  repeat
    do
      item
        settle 10
      item
        input esc
      item
        settle 2
      item "read the screen"
        read
          name desk
    until
      bind ready
      source desk
      mode text
      rect [31, 0, 119, 40]
      rect_at [1920, 1080]
      without [continue, back, later]
      words [finder]
    max 30


step "dismiss anything over the desktop"
  input esc
  settle 2


step "open spotlight"
  input meta_l+spc
  settle 4


step "type the settings app name"
  settle 7
  input text "system settings"


step "open it"
  input ret
  settle 14


step "the settings window is up"
  repeat
    do
      item
        settle 3
      item "read the screen"
        read
          name screen
    until
      bind done
      source screen
      mode text
      rect [590, 290, 1350, 690]
      rect_at [1920, 1080]
      words [[system, settings], [general], [wi-fi]]
    max 30

  # THE STEP IS CALLED "the remote login RESULT", AND IT WAS WAITING FOR THE PANEL'S CONTENTS.
  #
  # MEASURED ON RUN 44346450614, which failed after 45 attempts at step 16 of 31:
  #
  #	status: failed step 16/31 "the remote login result is on screen"
  #	error:  the loop ran 45 attempt(s) and the condition never held
  #
  # THE FRAME IS THE SEARCH RESULT, NOT THE PANE: System Settings with `remote login` typed in the
  # search field and a `Remote login` row under Sharing in the sidebar. The words the check wanted -
  # "allow full disk access", which only the PANE shows - appear after the NEXT step clicks that row,
  # and the next step was never reached because this one never passed.
  #
  # SO IT WAITS FOR THE ROW IT ACTUALLY NEEDS, which is the thing the click after it aims at.

step "search for remote login - click the field"
  input 715 267


step "search for remote login - select what is there"
  input ctrl+a
  settle 1


step "search for remote login - delete the selection"
  input backspace
  settle 1


step "search for remote login - type the value"
  input text "remote login"
    modifier meta_l
  settle 10

step "the remote login result is on screen"
  repeat
    do
      item
        settle 2
      item "read the screen"
        read
          name screen
    until
      bind done
      source screen
      mode text
      rect [622, 304, 748, 365]
      rect_at [1920, 1080]
      scale 2
      words [[remote, login]]
    max 45


# THE RESULT ROW IS AT y=303, NOT y=336, AND THE PAGE IT OPENS SAYS SOMETHING ELSE.
#
# MEASURED on the local run: after searching "remote login" in System Settings, the result row sits at
# (677, 303) in the 1920x1080 capture. This step used to click (703, 336), 33 px low, so the detail
# pane never opened - which is why the gate after it waited thirty times for a page that was never
# there.
#
# THE GATE WAS ALSO ASKING ABOUT A DIFFERENT PANE. `allow full disk access` belongs to the Privacy
# page; the Remote Login sheet says "lets users of other computers access your Mac". macos 26's walk
# has always waited for that sentence, and this file now does too.
step "open the remote login pane"
  repeat
    do
      # (677, 335) IS THE `Remote login` ROW, AND IT IS THE SECOND ONE. The first result row is
      # `Sharing` at y=303, and clicking that opens the Sharing pane - MEASURED on run 7, whose frame
      # shows `Sharing` highlighted in blue with Remote login directly beneath it. An earlier fix
      # moved this from 336 to 303 and pointed it at the wrong row entirely; 336 was right and the
      # GATE was what needed changing.
      item "click the search result"
        input 677 335
        settle 5
      item "read the screen"
        read
          name screen
    until
      bind sheet
      source screen
      mode text
      # THE REGION IS THE SHEET'S TWO-LINE HEADER, NOT THE WHOLE PANE.
      #
      # MEASURED on run 8: with `rect [600,150,1600,900]` - the region macos 26 uses - the OCR of THIS
      # guest's sheet returned
      #
      #	k , Remote Login: Off 'computer using SSH and SFTP. ...
      #
      # and dropped `lets users of other computers access this` entirely, so the gate never matched a
      # sheet that was open on screen. THE SAME FRAME READ THROUGH A TIGHT CROP:
      #
      #	$ tesseract <crop 750,330-1200,390> -
      #	Remote Login: Off
      #	Remote Login lets users of other computers access this
      #	computer using SSH and SFTP.
      #
      # 15's sheet is a CENTRED DIALOG about 465x410 px, not the full-height pane 26 shows, so the
      # wide region spends most of its pixels on the dimmed System Settings behind it and the small
      # text in the middle is what gets lost.
      rect [750, 330, 1200, 390]
      rect_at [1920, 1080]
      # scale 1, NOT 2: MEASURED on this frame, the same crop at 2x reads
      # `i= Remote Login: Off (` / `[> | . . NN` - the enlargement adds noise to text that is already
      # legible, which is the opposite of what `scale:` is for.
      scale 1
      words [[lets, users, of, other, computers]]
    max 12



step "turn remote login on"
  input 1145 353
  rect [726, 300, 1200, 715]
  rect_at [1920, 1080]
  scale 2
  settle 4
  when_not [log, in, to, this, computer]


step "the switch reads on"
  repeat
    do
      item
        settle 3
      item "read the screen"
        read
          name screen
    until
      bind done
      source screen
      mode text
      rect [787, 336, 953, 395]
      rect_at [1920, 1080]
      words [[log, in, to, this, computer]]
    max 10


step "close the pane"
  input 1145 679
  settle 5


step "wait for sshd"
  repeat
    until machine_ssh
    max 60
    pause 10


step "prove the build over ssh"
  ssh "sw_vers -productVersion"


step "prove the account over ssh"
  ssh "id -un"


step "prove disk utility works over ssh"
  ssh "diskutil list | head -5"


step "name the machine"
  ssh "printf '%s\\n' \"{{ password }}\" | sudo -S scutil --set LocalHostName {{ user }}"


step "note what is absent"
  ssh "command -v brew || true"


# THE SLEEP IMAGE AND THE LOCAL SNAPSHOTS WERE DELETED HERE, AND THIS STAGE NO LONGER DOES THAT.
#
# THEY WERE REMOVED TO SHRINK A DIFF THAT COULD NOT BE SHRUNK: the step's own measurement was
#
#	/dev/disk2s4s1   128Gi    22Gi    87Gi    21%    426k  915M    0%    /
#
# - the guest freed the files and the host diff did not get one byte of it back, because APFS does not
# hand deletes to `discard=unmap` while it runs. THE STEP WAS THEREFORE CORRECT AND USELESS AT THE SAME
# TIME, and the disk it wanted to shrink only existed because this file had `overlay false`.
#
# WITH A DIFF AND NO `overlay false` THERE IS NOTHING TO SHRINK: the base is read-only, the diff holds
# what the guest wrote, and `publish` flattens the two. MACOS 26 HAS NEVER HAD THIS STEP, HAS ALWAYS
# USED A DIFF, AND PUBLISHES 16407 MiB - 18 GiB LESS THAN THIS FILE PUBLISHED WITH ITS CLEANUP.
#
# Deleting files from a user's system to make a runner fit is worth doing only when it works. Here it
# did not, and the thing it was compensating for is gone.


  # `shutdown: ssh` RATHER THAN A HAND-WRITTEN `poweroff`, BECAUSE THE HAND-WRITTEN ONE CANNOT WIN.
  #
  # MEASURED ON RUN 44450353655, step 29 of 31 - the step before the last:
  #
  #	status: failed step 29/31 "ask the guest to power off"
  #	error:   ask the guest to power off: the command exited 1
  #
  # AND THE LOG ENDS AT `Password:`: `poweroff` closed the connection the command was being read
  # over, so ssh saw EOF and reported 1 for the shutdown that had just worked. There is no exit code
  # a successful `poweroff` over ssh can return - the session dies with the machine.
  #
  # `macos/26/steps/ssh.walk` HAD THIS RIGHT ALL ALONG with `shutdown: ssh`, which is the method that
  # sends the command AND tolerates the connection ending. This file now uses it too, and the
  # `wait_until: stopped` after it is what actually confirms the machine went down.

# THE MENU BAR SHUTS THE GUEST DOWN, BECAUSE THAT IS THE ONLY SHUTDOWN macOS HONOURS HERE.
#
# THE CI LOG OF THE 33.10 GiB RUN SAYS WHAT THE OLD STEP DID (run 45840734390, step 61/63):
#
#	=== stop the machine
#	[easyvm]   the guest did not power off within 5m0s; killing it - the disk will need a journal
#	           replay on its next boot
#	[easyvm]   released the diff (23950 MiB written this run)
#
# `stop ssh` sends `poweroff`, and `poweroff` from `vmuser` never reached the shutdown path - so `stop`
# waited its full five minutes and KILLED qemu. A killed guest never runs its own shutdown sequence, and
# that sequence is what hands the blocks APFS freed back to the host's `discard=unmap`.
#
# SO THE GUEST IS SHUT DOWN THE WAY A PERSON SHUTS A MAC DOWN: Apple menu -> Shut Down, then Return for
# the confirmation if one appears. NO `sudo`, NO `shutdown(8)` - the desktop's own control, because that
# is the path this media actually implements.
#
# THE APPLE MENU IS AT THE TOP LEFT. The gate above already proves the bar is there: it reads
# `finder` inside rect [31, 0, 119, 40], and the Apple logo sits in the same bar to the LEFT of that
# rect. `input 18 18` is that logo.
step "open the apple menu"
  input 18 18
  settle 3


step "choose shut down from it"
  input 40 204
  settle 5


# A CONFIRMATION IS ANSWERED WITH RETURN, NOT WITH A GUESSED COORDINATE. `Shut Down` is the default
# button whenever macOS asks, and Return is harmless on the desktop if it does not ask at all.
step "answer the confirmation if one appears"
  input ret
  settle 4


step "wait for the machine to stop"
  wait_until stopped
  timeout 300


step "stop the machine"
  stop kill
  timeout 60


step "publish the disk"
    save "{{ out }}"
