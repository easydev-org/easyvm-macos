walkthrough "macos 15 ssh - the setup assistant, remote login, and a graceful shutdown"
resolution 1920x1080
recording_resolution 1920x1080
user vmuser
var out
  default out/macos15-ssh.qcow2
  from args.out
password admin
var user
  default vmuser
  from args.user
boot_disk from_caller
ssh_port 2222


step "the media this stage boots from is already on disk"
  needs [boot.img, macos.rom, macos.vars]


step "boot the disk"
  boot
    machine "q35,accel=kvm,vmport=off"
    # THIS STAGE WRITES STRAIGHT TO THE DISK, BECAUSE A DIFF MAKES A PRODUCT THAT CANNOT SHRINK.
    #
    # THE ARITHMETIC IS THE WHOLE REASON. With a diff, `publish` flattens BASE ∪ DIFF:
    #
    #	base                     30,010,703,872 bytes  (27.95 GiB, the installer's own disk)
    #	every product so far     28,339 MiB / 31,599 MiB / 33,893 MiB   - never below the base
    #
    # A UNION OF A SET WITH ANYTHING IS AT LEAST THE SET. No amount of deleting inside the guest can
    # make a diff-over-base artifact smaller than the base it is flattened onto, which is exactly what
    # the four runs measured: the guest's `df -h /` said 10 GiB used while the product said 31.6 GiB.
    #
    # WITH `overlay false` THE GUEST'S WRITES AND ITS DELETES BOTH LAND ON THE ONE FILE, and `-drive`
    # carries `discard=unmap,detect-zeroes=unmap`, so the blocks the guest frees leave the product.
    # The file that gets compressed is then the disk's OWN usage, not the disk plus a second copy of
    # everything the guest rewrote.
    #
    # THE RECORD THAT USED TO ARGUE THE OTHER WAY IS KEPT, because what it measured was a different
    # mechanism - no `detect-zeroes=unmap` and no cleanup inside the guest:
    #
    #	             boot                 base before   base after   published
    #	macos 15     overlay false        28620 MiB     40981 MiB    34589 MiB
    #
    # 40981 MiB IS WHAT A DISK LOOKS LIKE WHEN NOTHING EVER UN-MAPS IT, and that is the half this file
    # now supplies. The peak it was turned off for is also gone: the recording ends before `publish`.
    #
    # WHAT IS GIVEN UP: a failed run now writes through to the disk it booted. That is acceptable here
    # because the base is pulled fresh from the registry on every run.
    overlay false
    args [["-m", "12288"], ["-cpu", "Skylake-Client-v4,vendor=GenuineIntel,vmx=off,vmware-cpuid-freq=on,-pdpe1gb,+invtsc,+ssse3,+sse4.2,+popcnt,+avx,+avx2,+aes,+fma,+bmi1,+bmi2,+smep,+xsave,+xsaveopt,+xgetbv1,+movbe,+rdrand,check"], ["-smp", "4,sockets=1,dies=1,cores=4,threads=1"], ["-drive", "if=pflash,format=raw,readonly=on,file=macos.rom"], ["-drive", "if=pflash,format=raw,file=macos.vars"], ["-drive", "file=boot.img,format=raw,if=none,id=oc"], ["-device", "virtio-blk-pci,drive=oc,bootindex=0"], ["-chardev", "socket,id=qga0,path=qga.sock,server=on,wait=off"], ["-device", "isa-serial,chardev=qga0"], ["-device", "qemu-xhci,id=xhci"], ["-device", "usb-tablet,bus=xhci.0"], ["-device", "usb-kbd,bus=xhci.0"], ["-drive", "file=disk.qcow2,if=none,format=qcow2,discard=unmap,detect-zeroes=unmap,id=target"], ["-device", "virtio-blk-pci,drive=target,bootindex=1"], ["-global", "ICH9-LPC.disable_s3=1"], ["-global", "ICH9-LPC.disable_s4=1"], ["-global", "ICH9-LPC.acpi-pci-hotplug-with-bridge-support=off"], ["-rtc", "base=utc"], ["-smbios", "type=2"], ["-device", "vmware-svga"], ["-audiodev", "none,id=snd0"], ["-device", "usb-audio,bus=xhci.0,audiodev=snd0"], ["-device", "isa-applesmc,osk=ourhardworkbythesewordsguardedpleasedontsteal(c)AppleComputerInc"], ["-netdev", "tap,id=net0,ifname=qemutap0,script=no,downscript=no"], ["-device", "virtio-net-pci,netdev=net0,mac=52:54:00:56:4d:01,romfile=,host_mtu=1450"]]
    timeout 900
# THE WIZARD IS A FIXED SEQUENCE, SO IT IS WRITTEN AS ONE - ONE PAGE PER STEP, NO LOOP.
#
# MEASURED TWICE FROM THE RECORDINGS (run 45773302724 and run 45791461278). The panes arrive in the
# same order on both, every time:
#
#	country -> transfer -> languages -> accessibility -> data & privacy -> account ->
#	apple sheet -> terms -> location -> time zone -> analytics -> screen time -> look -> update
#
# THE LOOP THIS REPLACES RE-READ THE SCREEN AND RE-ASKED ALL SEVENTEEN CHECKS ON EVERY PASS, and each
# check was a full OCR of a 1920x1080 frame. A linear sequence of fourteen panes cost thirty to seventy
# minutes depending on how many passes it needed. A sequence has no such cost: each page is waited for
# once, answered once, and the next page is waited for.
#
# WHY THE ORDER IS RELIABLE ENOUGH TO WRITE DOWN. The loop existed because the Setup Assistant was
# assumed to be unpredictable. The recordings say otherwise: run 45791461278 crossed thirteen panes in
# nineteen rounds, every one a NEW pane, with none visited twice.
#
# EACH PAGE IS TWO STEPS, BECAUSE A STEP DOES ONE THING: one waits for the pane's own title, the next
# answers it. A page that never arrives fails in its waiting step, naming the title it wanted - where
# the loop would have re-tried it silently until its cap, which is how run 45773302724 spent 66
# minutes on one pane.

# THE FIRST PAGE TAKES MINUTES, NOT SECONDS: the guest is still booting when this step starts, and
# macOS spends two to five minutes in the boot before the Setup Assistant draws anything.
#
# MEASURED on the local probe: `boot:` returns as soon as qemu is up (412 ms), and the frame two
# seconds later is still black. A `settle` here has to cover the whole boot, because the page it is
# waiting for cannot appear until the boot is done.
# THE OPENCORE PICKER CAN APPEAR FIRST WHEN THE DISK IS WRITTEN DIRECTLY, AND RETURN CHOOSES `main`.
#
# MEASURED on run 45931943076 - the first run with `overlay false`. The guest reached OpenCore's own
# boot picker and stayed there, with one entry on screen:
#
#	[ main ]
#	REL-105 2025-07-07
#
# and the walk, which was waiting for "select your country or region", saw nothing but the picker for
# ninety attempts. The console says what led there:
#
#	BdsDxe: loading Boot0001 "UEFI Misc Device" from PciRoot(0x0)/Pci(0x1,0x0)
#	apfs.efi: LocateProtocol(AppleLogging) succeeded
#
# SO A RETURN IS SENT BEFORE THE PAGE IS WAITED FOR. It picks the entry that is already highlighted, and
# it is harmless in the case this file used to rely on - with a diff, OpenCore boots straight through
# and the keystroke is a no-op on a screen that is already past.
step "let the boot picker through, if it is up"
  input ret
  settle 5


step "wait for the country or region page"
  repeat
    do
      item "read the screen"
        read
          name pane
    until
      bind up
      source pane
      mode text
      rect [0, 0, 1920, 1080]
      rect_at [1920, 1080]
      scale 1
      words [[select, your, country, or, region]]
    # 2s between reads: the engine's own default, said out loud.
    pause 2
    max 90

step "answer the country or region page"
  do
    item
      input 900 500
      settle 2
    item
      input text "united states"
      settle 4
    item
      input 1306 810
      settle 10

step "wait for the transfer page"
  repeat
    do
      item "read the screen"
        read
          name pane
    until
      bind up
      source pane
      mode text
      rect [0, 0, 1920, 1080]
      rect_at [1920, 1080]
      scale 1
      words [[transfer, your, information, to, this, mac]]
    # 2s between reads: the engine's own default, said out loud.
    pause 2
    max 45

step "answer the transfer page"
  do
    item
      input 825 669
      settle 4
    item
      input 1306 810
      settle 10

step "wait for the spoken languages page"
  repeat
    do
      item "read the screen"
        read
          name pane
    until
      bind up
      source pane
      mode text
      rect [0, 0, 1920, 1080]
      rect_at [1920, 1080]
      scale 1
      words [[spoken, languages]]
    # 2s between reads: the engine's own default, said out loud.
    pause 2
    max 45

step "answer the spoken languages page"
  do
    item
      input 1306 810
      settle 10

step "wait for the accessibility page"
  repeat
    do
      item "read the screen"
        read
          name pane
    until
      bind up
      source pane
      mode text
      rect [0, 0, 1920, 1080]
      rect_at [1920, 1080]
      scale 1
      words [[accessibility, individual]]
    # 2s between reads: the engine's own default, said out loud.
    pause 2
    max 45

step "answer the accessibility page"
  do
    item
      input 1306 806
      settle 12

step "wait for the data and privacy page"
  repeat
    do
      item "read the screen"
        read
          name pane
    until
      bind up
      source pane
      mode text
      rect [0, 0, 1920, 1080]
      rect_at [1920, 1080]
      scale 1
      words [[privacy, fundamental]]
    # 2s between reads: the engine's own default, said out loud.
    pause 2
    max 45

step "answer the data and privacy page"
  do
    item
      input 1306 810
      settle 10

step "wait for the create a mac account page"
  repeat
    do
      item "read the screen"
        read
          name pane
    until
      bind up
      source pane
      mode text
      rect [0, 0, 1920, 1080]
      rect_at [1920, 1080]
      scale 1
      words [[create, a, mac, account, here]]
    # 2s between reads: the engine's own default, said out loud.
    pause 2
    max 60

# THE SETTLE GOES BEFORE THE TEXT, NOT AFTER IT. MEASURED on the local run at step 14/61: the frame
# after this step showed "Create a Mac Account" with the Full name field FOCUSED AND EMPTY - the click
# had landed and the typing had not. The loop this replaced wrote it the other way round:
#
#	item "account user text"
#	  settle 3            <- wait for the click's focus to take
#	  input text "..."
#
# so the field was given three seconds to become the keyboard's target before any key was sent. Here
# the settle was on the far side, and the keys went to a window that had not taken focus yet.
step "answer the create a mac account page"
  do
    item
      input 945 447
      settle 5
    item
      settle 3
      input text "{{ user }}"
    item
      settle 2
    item
      input 850 531
      settle 5
    item
      settle 3
      input text "{{ password }}"
    item
      settle 2
    item
      input 1086 531
      settle 5
    item
      settle 3
      input text "{{ password }}"
    item
      settle 3
    item
      input 1306 810
      settle 180

# SKIPPING THE APPLE ACCOUNT IS TWO CLICKS, AND THE FIRST ONE WAS MISSING.
#
# MEASURED across runs 4 and 5. The pane "Sign In to Your Apple Account" has its way out at the
# BOTTOM LEFT - `Set Up Later` at (615, 808) - and clicking it raises a SECOND sheet:
#
#	Are you sure you want to skip signing in with an Apple Account?
#	[ Don't Skip ]   [ Skip ]
#
# The walk only had the second click (1018, 641). With no sheet on screen that click landed on the
# Sign In pane itself, and the sheet then appeared ON TOP OF EVERY LATER STEP: run 5's recording is
# that sheet from 13:08 to the end, with each subsequent click (migration assistant, login field,
# password, return) landing on it or behind it.
step "set the apple account up later"
  input 615 808
  settle 10


step "wait for the apple account confirmation sheet"
  repeat
    do
      item "read the screen"
        read
          name pane
    until
      bind up
      source pane
      mode text
      rect [0, 0, 1920, 1080]
      rect_at [1920, 1080]
      scale 1
      words [[sure, skip, signing]]
    # 2s between reads: the engine's own default, said out loud.
    pause 2
    max 45

step "answer the apple account confirmation sheet"
  do
    item
      input 1018 641
      settle 10

step "wait for the terms and conditions page"
  repeat
    do
      item "read the screen"
        read
          name pane
    until
      bind up
      source pane
      mode text
      rect [0, 0, 1920, 1080]
      rect_at [1920, 1080]
      scale 1
      words [[terms, conditions]]
    # 2s between reads: the engine's own default, said out loud.
    pause 2
    max 45

step "answer the terms and conditions page"
  do
    item
      input 1298 806
      settle 8
    item
      input 1019 616
      settle 10

step "wait for the location services page"
  repeat
    do
      item "read the screen"
        read
          name pane
    until
      bind up
      source pane
      mode text
      rect [0, 0, 1920, 1080]
      rect_at [1920, 1080]
      scale 1
      words [[enable, location, services]]
    # 2s between reads: the engine's own default, said out loud.
    pause 2
    max 45

step "answer the location services page"
  do
    item
      input 1306 810
      settle 6
    item
      input 960 632
      settle 3
    item
      input ret
      settle 6

step "wait for the time zone page"
  repeat
    do
      item "read the screen"
        read
          name pane
    until
      bind up
      source pane
      mode text
      rect [0, 0, 1920, 1080]
      rect_at [1920, 1080]
      scale 1
      words [[time, zone]]
    # 2s between reads: the engine's own default, said out loud.
    pause 2
    max 45

step "answer the time zone page"
  do
    item
      input 1306 806
      settle 10

step "wait for the analytics page"
  repeat
    do
      item "read the screen"
        read
          name pane
    until
      bind up
      source pane
      mode text
      rect [0, 0, 1920, 1080]
      rect_at [1920, 1080]
      scale 1
      words [[share, analytics, with, apple]]
    # 2s between reads: the engine's own default, said out loud.
    pause 2
    max 45

step "answer the analytics page"
  do
    item
      input 808 513
      settle 3
    item
      input 1306 810
      settle 10

step "wait for the screen time page"
  repeat
    do
      item "read the screen"
        read
          name pane
    until
      bind up
      source pane
      mode text
      rect [0, 0, 1920, 1080]
      rect_at [1920, 1080]
      scale 1
      words [[screen, time]]
    # 2s between reads: the engine's own default, said out loud.
    pause 2
    max 45

step "answer the screen time page"
  do
    item
      input 619 806
      settle 8

step "wait for the choose your look page"
  repeat
    do
      item "read the screen"
        read
          name pane
    until
      bind up
      source pane
      mode text
      rect [0, 0, 1920, 1080]
      rect_at [1920, 1080]
      scale 1
      words [[choose, your, look]]
    # 2s between reads: the engine's own default, said out loud.
    pause 2
    max 45

step "answer the choose your look page"
  do
    item
      input 1299 810
      settle 12

step "wait for the update mac automatically page"
  repeat
    do
      item "read the screen"
        read
          name pane
    until
      bind up
      source pane
      mode text
      rect [0, 0, 1920, 1080]
      rect_at [1920, 1080]
      scale 1
      words [[update, mac, automatically]]
    # 2s between reads: the engine's own default, said out loud.
    pause 2
    max 60

step "answer the update mac automatically page"
  do
    item
      input 1306 810
      settle 15


# THE WIZARD HAS ONE MORE PAGE, AND IT IS THE ONE NOBODY EXPECTED: THE MIGRATION ASSISTANT.
#
# MEASURED from run 3's recording (t=960s), after `answer the update mac automatically page`:
#
#	Transfer information to this Mac
#	Select a Mac, Time Machine backup, or other startup disk to transfer its information to this Mac.
#	                       [mnt1  !]
#	                       Other Server...
#	Not now                                    [ Back ]  [ Continue ]
#
# AND ITS `mnt1` IS A WARNING: clicking it (or Continue) opens
#
#	The selected source cannot be used for migration.
#	Volume contains a macOS or OS X installation which may be damaged.
#	                                  [ OK ]
#
# The way past is `Not now` at the BOTTOM LEFT, which no other page in this wizard has - every earlier
# pane puts its forward control at the bottom right.
#
# WITHOUT THIS STEP THE WALK IS OFF BY ONE PANE FOR EVERYTHING AFTER IT: it pressed Escape and
# Command-Q while the wizard was still open, macOS answered with
#
#	Do you want to shut down your computer?
#	You haven't finished setting up macOS.
#	[ Cancel ]  [ Shut Down ]
#
# and the "software licence" step then clicked (1307,805) - the wizard's Continue - on a page that was
# not a licence at all.
step "skip the migration assistant"
  input 606 808
  settle 15





step "dismiss anything over the login window"
  input esc
  settle 2


step "click the password field"
  input 965 981
  settle 2


step "type the password"
  settle 2
  input text "{{ password }}"


step "press return"
  input ret
  settle 20


# NO `meta_l+q` HERE. It was in the loop this replaces, and MEASURED on run 3 it is the one keystroke
# that must not be sent blind: with the wizard still open, Command-Q raises
#
#	Do you want to shut down your computer?
#	You haven't finished setting up macOS.
#	[ Cancel ]  [ Shut Down ]
#
# which then swallows every later click. Escape closes the "what's new" and notification overlays and
# cannot shut the machine down, so the dismissal is Escape three times with a click on the empty
# desktop between them to take the focus away from any sheet.
step "dismiss the overlays macOS puts up on a first login"
  do
    item
      input esc
      settle 3
    item
      input 1228 826
      settle 3
    item
      input esc
      settle 3
    item
      input 1228 826
      settle 3
    item
      input esc
      settle 3


# THE SOFTWARE LICENCE COMES BACK AFTER THE FIRST LOGIN, AND IT BLOCKS THE DESKTOP.
#
# MEASURED on the local run at step 36/61: the frame during `wait for the desktop` is
#
#	Terms and Conditions
#	... PLEASE READ THIS SOFTWARE LICENSE AGREEMENT ...
#	                                          [ Back ]  [ Agree ]
#
# THE WIZARD'S OWN TERMS PAGE WAS ALREADY ANSWERED at step 18. THIS IS A SECOND, DIFFERENT ONE - the
# licence macOS shows to the first user who logs in - and nothing in the walk answered it, so the loop
# waited for a Finder menu behind a modal sheet that would never close.
#
# (1307, 805) IS MEASURED FROM THAT FRAME: the Agree button's centre in the 1920x1080 capture. The
# wizard's terms step uses (1298, 806), which is the same control on a differently laid-out page.
step "wait for the software licence the first login shows"
  # 30s, MEASURED: run 2's journal has the licence on screen by 12:12:40, which is immediately after
  # `dismiss the overlays` finishes (12:12:21 press return + 20s, then 19s of overlay clicks). The
  # settle covers the sheet's own animation on top of that.
  settle 30


step "accept the software licence the first login shows"
  input 1307 805
  settle 20


step "wait for the desktop"
  repeat
    do
      item
        settle 10
      item
        input esc
      item
        settle 2
      item "read the screen"
        read
          name desk
    until
      bind ready
      source desk
      mode text
      rect [31, 0, 119, 40]
      rect_at [1920, 1080]
      without [continue, back, later]
      words [finder]
    max 30


step "dismiss anything over the desktop"
  input esc
  settle 2


step "open spotlight"
  input meta_l+spc
  settle 4


step "type the settings app name"
  settle 7
  input text "system settings"


step "open it"
  input ret
  settle 14


step "the settings window is up"
  repeat
    do
      item
        settle 3
      item "read the screen"
        read
          name screen
    until
      bind done
      source screen
      mode text
      rect [590, 290, 1350, 690]
      rect_at [1920, 1080]
      words [[system, settings], [general], [wi-fi]]
    max 30

  # THE STEP IS CALLED "the remote login RESULT", AND IT WAS WAITING FOR THE PANEL'S CONTENTS.
  #
  # MEASURED ON RUN 44346450614, which failed after 45 attempts at step 16 of 31:
  #
  #	status: failed step 16/31 "the remote login result is on screen"
  #	error:  the loop ran 45 attempt(s) and the condition never held
  #
  # THE FRAME IS THE SEARCH RESULT, NOT THE PANE: System Settings with `remote login` typed in the
  # search field and a `Remote login` row under Sharing in the sidebar. The words the check wanted -
  # "allow full disk access", which only the PANE shows - appear after the NEXT step clicks that row,
  # and the next step was never reached because this one never passed.
  #
  # SO IT WAITS FOR THE ROW IT ACTUALLY NEEDS, which is the thing the click after it aims at.

step "search for remote login - click the field"
  input 715 267


step "search for remote login - select what is there"
  input ctrl+a
  settle 1


step "search for remote login - delete the selection"
  input backspace
  settle 1


step "search for remote login - type the value"
  input text "remote login"
    modifier meta_l
  settle 10

step "the remote login result is on screen"
  repeat
    do
      item
        settle 2
      item "read the screen"
        read
          name screen
    until
      bind done
      source screen
      mode text
      rect [622, 304, 748, 365]
      rect_at [1920, 1080]
      scale 2
      words [[remote, login]]
    max 45


# THE RESULT ROW IS AT y=303, NOT y=336, AND THE PAGE IT OPENS SAYS SOMETHING ELSE.
#
# MEASURED on the local run: after searching "remote login" in System Settings, the result row sits at
# (677, 303) in the 1920x1080 capture. This step used to click (703, 336), 33 px low, so the detail
# pane never opened - which is why the gate after it waited thirty times for a page that was never
# there.
#
# THE GATE WAS ALSO ASKING ABOUT A DIFFERENT PANE. `allow full disk access` belongs to the Privacy
# page; the Remote Login sheet says "lets users of other computers access your Mac". macos 26's walk
# has always waited for that sentence, and this file now does too.
step "open the remote login pane"
  repeat
    do
      # (677, 335) IS THE `Remote login` ROW, AND IT IS THE SECOND ONE. The first result row is
      # `Sharing` at y=303, and clicking that opens the Sharing pane - MEASURED on run 7, whose frame
      # shows `Sharing` highlighted in blue with Remote login directly beneath it. An earlier fix
      # moved this from 336 to 303 and pointed it at the wrong row entirely; 336 was right and the
      # GATE was what needed changing.
      item "click the search result"
        input 677 335
        settle 5
      item "read the screen"
        read
          name screen
    until
      bind sheet
      source screen
      mode text
      # THE REGION IS THE SHEET'S TWO-LINE HEADER, NOT THE WHOLE PANE.
      #
      # MEASURED on run 8: with `rect [600,150,1600,900]` - the region macos 26 uses - the OCR of THIS
      # guest's sheet returned
      #
      #	k , Remote Login: Off 'computer using SSH and SFTP. ...
      #
      # and dropped `lets users of other computers access this` entirely, so the gate never matched a
      # sheet that was open on screen. THE SAME FRAME READ THROUGH A TIGHT CROP:
      #
      #	$ tesseract <crop 750,330-1200,390> -
      #	Remote Login: Off
      #	Remote Login lets users of other computers access this
      #	computer using SSH and SFTP.
      #
      # 15's sheet is a CENTRED DIALOG about 465x410 px, not the full-height pane 26 shows, so the
      # wide region spends most of its pixels on the dimmed System Settings behind it and the small
      # text in the middle is what gets lost.
      rect [750, 330, 1200, 390]
      rect_at [1920, 1080]
      # scale 1, NOT 2: MEASURED on this frame, the same crop at 2x reads
      # `i= Remote Login: Off (` / `[> | . . NN` - the enlargement adds noise to text that is already
      # legible, which is the opposite of what `scale:` is for.
      scale 1
      words [[lets, users, of, other, computers]]
    max 12



step "turn remote login on"
  input 1145 353
  rect [726, 300, 1200, 715]
  rect_at [1920, 1080]
  scale 2
  settle 4
  when_not [log, in, to, this, computer]


step "the switch reads on"
  repeat
    do
      item
        settle 3
      item "read the screen"
        read
          name screen
    until
      bind done
      source screen
      mode text
      rect [787, 336, 953, 395]
      rect_at [1920, 1080]
      words [[log, in, to, this, computer]]
    max 10


step "close the pane"
  input 1145 679
  settle 5


step "wait for sshd"
  repeat
    until machine_ssh
    max 60
    pause 10


step "prove the build over ssh"
  ssh "sw_vers -productVersion"


step "prove the account over ssh"
  ssh "id -un"


step "prove disk utility works over ssh"
  ssh "diskutil list | head -5"


step "name the machine"
  ssh "printf '%s\\n' \"{{ password }}\" | sudo -S scutil --set LocalHostName {{ user }}"


step "note what is absent"
  ssh "command -v brew || true"


# THE SLEEP IMAGE IS TWELVE GIGABYTES AND IT IS THE DIFFERENCE BETWEEN 15 GiB AND 28 GiB.
#
# THIS STEP WAS HERE, WAS REMOVED, AND IS BACK WITH THE MEASUREMENT THAT SAYS WHY IT MATTERS.
#
#	`/private/var/vm/sleepimage` is written at hibernatemode 3 with a size near the guest's RAM,
#	which is 12288 MiB on this machine. TWO PRODUCTS OF THE SAME 63 STEPS, one with this delete and
#	one without:
#
#		with it      15.10 GiB product, 19.27 GiB of data extents, empty space from 36 GiB up
#		without it   27.68 GiB product, 32.36 GiB of data extents (the install disk's own figure)
#
#	12.6 GiB - the sleep image, to the megabyte.
#
# WHY THE DELETE ACTUALLY HANDS THE CLUSTERS BACK: `discard=unmap` is on the disk's `-drive` line, so
# a delete inside the guest reaches the host's overlay. That is the whole mechanism, and it is why
# removing the file here shrinks the artifact rather than only freeing space the guest could reuse.
#
# WHAT IS REMOVED, AND WHY EACH IS SAFE:
#
#	sleepimage        this image offers no hibernation and macOS recreates it if it ever wants one
#	swapfiles         matched to guest RAM and recreated on demand by `dynamic_pager`
#	local snapshots   Time Machine's, purgeable by definition, and `tmutil` reports any it skips
#
# `df -h /` IS PRINTED BY THE STEP ITSELF, so the log says whether it worked instead of leaving the
# next reader to infer it from an artifact 12 GiB too large.
# THE HIBERNATION IMAGE IS TURNED OFF AS WELL AS DELETED, BECAUSE DELETING IT IS ONLY HALF THE JOB.
#
# `rm` REMOVES THE 12 GiB FILE THAT IS THERE NOW; `pmset -a hibernatemode 0` STOPS macOS WRITING THE
# NEXT ONE. With hibernatemode 3 - the desktop default - the kernel writes a file the size of RAM the
# first time it decides to hibernate, and a product built from this disk would carry it again on its
# own first boot. `0` is "do not hibernate": sleep stays in RAM, no image is written, and the setting is
# stored in the power-management preferences, so it survives the reboot this disk is about to have.
#
# `autopoweroff` IS SET TOO, because on some models macOS uses it in place of hibernate and it writes
# the same image. Both are harmless for a VM: there is no battery to protect and no state to preserve
# across a power cut that this stage cares about.
#
# `pmset -g custom` IS PRINTED BY THE STEP, so the log proves the setting took rather than assuming it.
step "stop macOS writing a hibernation image at all"
  ssh "printf '%s\\n' \"{{ password }}\" | sudo -S -p '' pmset -a hibernatemode 0 autopoweroff 0 2>&1 | tail -3; echo '--- what it says now ---'; pmset -g custom 2>&1 | grep -iE 'hibernatemode|autopoweroff' | head -4"
  timeout 300


# AND THE IMAGE THAT IS ALREADY THERE IS REMOVED, WITH THE SWAPFILES AND THE LOCAL SNAPSHOTS.
#
# THE MEASUREMENT THAT SAYS THIS STEP IS WORTH KEEPING - two products of the same 63 steps:
#
#	with it      15.10 GiB product, 19.27 GiB of data extents, empty space from 36 GiB up
#	without it   27.68 GiB product, 32.36 GiB of data extents (the install disk's own figure)
#
# 12.6 GiB, which is `/private/var/vm/sleepimage` at the guest's 12288 MiB of RAM, to the megabyte.
# `discard=unmap` is on the disk's `-drive` line, so a delete INSIDE the guest reaches the host's
# overlay and the clusters come back - that is the mechanism, and it is why removing the file here
# shrinks the artifact rather than only freeing space the guest can reuse.
#
#	sleepimage        recreated only if hibernation is asked for, and step above just turned it off
#	swapfiles         matched to guest RAM, recreated on demand by `dynamic_pager`
#	local snapshots   Time Machine's, purgeable by definition, and `tmutil` reports any it skips
#
# `df -h /` IS PRINTED BY THE STEP ITSELF, so the log says whether it worked instead of leaving the
# next reader to infer it from an artifact 12 GiB too large.
step "give the overlay back the space the guest spent"
  ssh "printf '%s\\n' \"{{ password }}\" | sudo -S -p '' sh -c 'rm -f /private/var/vm/sleepimage; rm -f /private/var/vm/swapfile*; for s in $(tmutil listlocalsnapshots / 2>/dev/null | sed -n \"s/^com\\.apple\\.TimeMachine.*\\.\\(.*\\)$/\\1/p\"); do tmutil deletelocalsnapshots \"$s\" 2>/dev/null; done; sync; echo \"--- sleepimage now ---\"; ls -l /private/var/vm/ 2>&1 | head -4; df -h / | tail -1'"
  timeout 300


# APFS DOES NOT TELL THE HOST ABOUT A DELETE, SO THE FREED BLOCKS ARE ZEROED INSTEAD.
#
# MEASURED on runs 45921917406 and 45928114170 - the guest's own `df` against the artifact it produced:
#
#	                        guest / used      overlay written      product
#	15848dd (no cleanup)    35.0 GB           16,500 MiB           28,339 MiB
#	3cf7179 (rm+no hib.)    10 GiB            21,450 MiB           31,599 MiB
#
# THE GUEST FREED 25 GB AND THE ARTIFACT GREW. `discard=unmap` alone cannot help: APFS is copy-on-write
# and answers a delete by dropping a reference, not by sending the host a discard. The old run that
# produced 15.10 GiB did not trim either - it happened to write far less in the first place.
#
# TWO THINGS ARE NEEDED, AND THIS FILE NOW HAS BOTH:
#
#	detect-zeroes=unmap on the disk's `-drive` line   qemu un-maps a block when it is WRITTEN as zeros
#	this step writes zeros over the free space        so the freed blocks ARE written as zeros
#
# `diskutil secureErase freespace` CANNOT DO IT on APFS - measured, it answers
# `-69489: Secure erase by writing a run of bytes to an APFS Volume makes no sense due to its possibly
# unbounded size`. `dd` can: one file of zeros, written until the volume is full, then deleted. The
# blocks are zero when qemu sees them, so they are dropped from the overlay even though APFS never
# issued a discard for them.
#
# THE FILE IS REMOVED EVEN IF `dd` ITSELF FAILS, which is why the `rm` is a separate command and not
# chained with `&&`: a half-written file left behind would be worse than the space it was meant to free.
# NOTHING IS ZERO-FILLED HERE. `macos26` HAS NEVER DONE IT AND PUBLISHES 16407 MiB.
#
# THIS FILE HAD A `dd` THAT WROTE ZEROS OVER THE FREE SPACE, AND IT WAS THE WRONG IDEA FOR A REASON
# THAT IS IN ITS OWN LOG. MEASURED, run 45934122711 step 64/72:
#
#	before
#	/dev/disk2s4s1   128Gi    10Gi   106Gi     9%    /
#	after
#	/dev/disk2s4s1   128Gi    10Gi   106Gi     9%    /
#
# THE `dd` CHANGED NOTHING, TWICE: on `/private/var/vm/` (the sealed system volume, which has no room
# to give) and on `/System/Volumes/Data`. Writing zeros is also exactly what `qemu-img convert -c`
# does NOT need - it skips a block that is a HOLE, and a hole is what `discard=unmap` creates, not what
# a `dd` creates.
#
# `macos/26/steps/ssh.walk` IS THE REFERENCE AND IT HAS NO CLEANUP AT ALL. It boots, drives the wizard,
# turns Remote Login on, and stops - no `rm`, no `dd`, no `tmutil`, no `pmset`. It publishes 16407 MiB
# from a 33618 MiB base. THAT IS THE SHAPE THIS FILE NOW TAKES: the deletes this walk really needs are
# the ones the wizard itself makes, and `discard=unmap` on the `-drive` line is what turns them into
# holes the publish step can drop.
#
# WHAT IS STILL DONE, AND ONLY THIS: the ONE file this disk writes that no other stage wants - the
# hibernation image - is removed and hibernation is switched off, so the product does not carry 12 GiB
# of sleep state into every later stage. That is a product decision, not a shrinking trick, and both
# steps print their own evidence.


# THE SEALED SYSTEM SNAPSHOT IS NOT LEFTOVER, AND THIS STAGE MUST NOT TRY TO DELETE IT.
#
# MEASURED on run 45921917406, step 62/69 - the attempt, and the answer:
#
#	Snapshot:            55B3E243-9415-4B9F-8D34-29FB1C976510
#	Name:                com.apple.os.update-C3E67B36246419E7...
#	Snapshot Mount Point: /
#	Snapshot Sealed:      Yes
#	Deleting APFS Snapshot ... Error: -69529: Unable to delete the given APFS Snapshot
#
# `com.apple.os.update-<sha>` IS THE SEALED SYSTEM VOLUME SNAPSHOT - the thing macOS boots from by
# design, not a residue the installer forgot. Apple's own documentation and every report of -69529 say
# the same: it cannot be deleted while it is the booted snapshot, and it is not meant to be. An earlier
# version of this file tried, and the try is what the log above records.
#
# SO THE STEP REPORTS IT AND STOPS. The list is still worth printing on every run: it is the one line
# that separates "the disk has a system snapshot, as macOS requires" from "the disk has an extra copy
# of the system", and the two look identical in a file listing.
step "what the disk's apfs snapshot is, and that it must stay"
  ssh "diskutil apfs listSnapshots / 2>&1 | head -14; echo '--- why it stays ---'; diskutil apfs list 2>&1 | grep -iE 'Sealed|Mount Point|Capacity In Use' | head -6"


# THE MENU BAR SHUTS THE GUEST DOWN, BECAUSE THAT IS THE ONLY SHUTDOWN macOS HONOURS HERE.
#
# THE CI LOG OF THE 33.10 GiB RUN SAYS WHAT THE OLD STEP DID (run 45840734390, step 61/63):
#
#	=== stop the machine
#	[easyvm]   the guest did not power off within 5m0s; killing it - the disk will need a journal
#	           replay on its next boot
#	[easyvm]   released the diff (23950 MiB written this run)
#
# `stop ssh` sends `poweroff`, and `poweroff` from `vmuser` never reached the shutdown path - so `stop`
# waited its full five minutes and KILLED qemu. A killed guest never runs its own shutdown sequence, and
# that sequence is what hands the blocks APFS freed back to the host's `discard=unmap`.
#
# SO THE GUEST IS SHUT DOWN THE WAY A PERSON SHUTS A MAC DOWN: Apple menu -> Shut Down, then Return for
# the confirmation if one appears. NO `sudo`, NO `shutdown(8)` - the desktop's own control, because that
# is the path this media actually implements.
#
# THE COORDINATES BELOW WERE MEASURED ON THIS GUEST, NOT GUESSED.
#
# MEASURED on the pod, 2026-11-26, by driving /api/click and capturing the frame after each press. THE
# FIRST VERSION OF THIS STEP USED `40 204` AND `ret`, AND THE RUN PROVED BOTH WRONG:
#
#	'easyvm' journal for run 2026-11-26T20-32-55:
#	  'open the apple menu',                    click 18,18   -> menu OPENED
#	  'choose shut down from it',               click 40,204  -> MISSED (menu closed, nothing else)
#	  'answer the confirmation if one appears', key   ret     -> nothing to answer
#	  then the walk sat at 'wait for the machine to stop' with ssh still answering
#
# THE MENU'S OWN FRAME THEN GAVE THE REAL ROW: `Shut Down...` is at y=244, forty pixels BELOW the
# `Sleep`/`Restart` pair an 204 sat between. And the confirmation sheet that `Shut Down...` raises is
#
#	Are you sure you want to shut down your computer now?
#	If you do nothing, the computer will shut down automatically in 58 seconds.
#	                                        [ Cancel ]  [ Shut Down ]
#
# whose default button is at (1097, 366) - Return does NOT press it, because the sheet takes its answer
# from the button, not from the keyboard focus the desktop had.
#
# THE CLICKS BELOW ARE THE ONES THAT WORKED, in order, on that same live guest:
#
#	18,12     the Apple logo        the menu drops down
#	40,244    Shut Down...          the confirmation sheet appears
#	1097,366  Shut Down             qemu leaves 'running' and the walk's wait is satisfied
#
# And the 58-second countdown is a second way in: if the third click ever misses, the sheet shuts the
# guest down on its own before the step's budget is spent.
step "open the apple menu"
  input 18 12
  settle 3


step "choose shut down from it"
  input 40 244
  settle 5


step "answer the confirmation sheet"
  input 1097 366
  settle 5


# THE GUEST NEEDS TIME AFTER `Shut Down`, AND THAT WAIT IS WORTH 13.8 GB OF PRODUCT.
#
# MEASURED on the pod, twice, same clean base (`5edfbab98aff3938`), same 66 steps, both shut down from
# this menu:
#
#	20:32:55 run   the confirmation click landed 2m30s late (a manual click), and the guest went on
#	               running for those 2m30s  -> product 15.20 GiB (16,318,070,784 bytes)
#	               and that product is 13.8 GB SMALLER than the base it was flattened onto:
#	                 base    30,010,707,968 bytes
#	                 product 16,214,589,440 bytes
#	               which is `discard=unmap` actually firing: APFS handed 13.8 GB of freed blocks back.
#
#	20:50:40 run   the confirmation click landed at once, the walk went on to `publish` 97 seconds
#	               later                              -> product 28.36 GiB (30,454,710,272 bytes)
#	               `qemu-img compare` against the base: IDENTICAL CONTENT, and the base's blocks were
#	               all still there - not one byte handed back.
#
# `wait_until stopped` RETURNED IMMEDIATELY IN THE SECOND RUN, because qemu had already left `running`
# when `Shut Down` was clicked. A DEAD QEMU PROCESS IS NOT A FINISHED SHUTDOWN: the guest's own
# unmount/trim work is what reaches `discard=unmap`, and `publish` must not flatten the diff until it
# is done. THE DIFFERENCE BETWEEN THE TWO RUNS WAS 13.8 GB OF PRODUCT, and it was entirely this wait.
step "let the guest finish handing its blocks back"
  settle 180


step "wait for the machine to stop"
  wait_until stopped
  timeout 300


step "stop the machine"
  stop kill
  timeout 60


step "publish the disk"
    save "{{ out }}"
