walkthrough "macos 26 - developer toolchain"
resolution 1920x1080
recording_resolution 1920x1080
user vmuser
var out
  default out/distro.qcow2
  from args.out
password admin
var shutdown
  default ssh
  from args.shutdown
var user
  default vmuser
  from args.user
boot_disk from_caller
ssh_port 2222
# MACOS 26 GETS XCODE 26.6, AND THE TWO MACOS CHAINS DELIBERATELY USE DIFFERENT VERSIONS.
#
# MEASURED FROM APPLE'S OWN REQUIREMENTS TABLE:
#
#	Xcode 26.3   macOS Sequoia 15.6 - Tahoe 26.x     <- the newest SEQUOIA can run, so 15 keeps it
#	Xcode 26.4.1 macOS Tahoe 26.2 - 26.x
#	Xcode 26.5   macOS Tahoe 26.2 - 26.x
#	Xcode 26.6   macOS Tahoe 26.2 - 26.x             <- the newest 26.x, and the newest for INTEL
#	Xcode 27     macOS Tahoe 26.6+, APPLE SILICON ONLY
#
# Xcode 27 IS NOT AN OPTION HERE AND THAT IS NOT A JUDGEMENT CALL. Its release notes say "Xcode 27
# will only install and run on Apple silicon Macs", and Apple's September 2026 post says "macOS 26
# is the final release supporting Intel Mac computers". A guest on this chain is x86_64, so 26.6 is
# the end of the line.
#
# `Universal` RATHER THAN `Apple_silicon`: both are published for every 26.x release, and the Apple
# silicon one does not install on an Intel Mac (xcodes issue #456 is that exact confusion).
#
# THE REST OF THIS FILE IS macos/15's dev.walk WITH THE VERSION CHANGED, because none of these steps
# touches the GUI - every one is `ssh:`, `scp:` or a script copied in and run. The coordinates that
# cost the ssh stage eighteen fixes do not exist here.
step "the media this stage boots from is already on disk"
  needs [boot.img, macos.rom, macos.vars, Xcode_26.6_Universal.xip, node.pkg, python.pkg]


step "boot the disk"
  boot
    machine "q35,accel=kvm,vmport=off"
    args [["-cpu", "Skylake-Client-v4,vendor=GenuineIntel,vmx=off,vmware-cpuid-freq=on,-pdpe1gb,+invtsc,+ssse3,+sse4.2,+popcnt,+avx,+avx2,+aes,+fma,+bmi1,+bmi2,+smep,+xsave,+xsaveopt,+xgetbv1,+movbe,+rdrand,check"], ["-smp", "4,sockets=1,dies=1,cores=4,threads=1"], ["-drive", "if=pflash,format=raw,readonly=on,file=macos.rom"], ["-drive", "if=pflash,format=raw,file=macos.vars"], ["-drive", "file=boot.img,format=raw,if=none,id=oc"], ["-device", "virtio-blk-pci,drive=oc,bootindex=0"], ["-chardev", "socket,id=qga0,path=qga.sock,server=on,wait=off"], ["-device", "isa-serial,chardev=qga0"], ["-device", "qemu-xhci,id=xhci"], ["-device", "usb-tablet,bus=xhci.0"], ["-device", "usb-kbd,bus=xhci.0"], ["-drive", "file=disk.qcow2,if=none,format=qcow2,discard=unmap,id=target"], ["-device", "virtio-blk-pci,drive=target,bootindex=1"], ["-global", "ICH9-LPC.disable_s3=1"], ["-global", "ICH9-LPC.disable_s4=1"], ["-global", "ICH9-LPC.acpi-pci-hotplug-with-bridge-support=off"], ["-rtc", "base=utc"], ["-smbios", "type=2"], ["-device", "vmware-svga"], ["-audiodev", "none,id=snd0"], ["-device", "usb-audio,bus=xhci.0,audiodev=snd0"], ["-device", "isa-applesmc,osk=ourhardworkbythesewordsguardedpleasedontsteal(c)AppleComputerInc"], ["-netdev", "tap,id=net0,ifname=qemutap0,script=no,downscript=no"], ["-device", "virtio-net-pci,netdev=net0,mac=52:54:00:56:4d:01,romfile=,host_mtu=1450"]]
    timeout 900
step "wait for sshd"
  repeat
    until machine_ssh
    max 90
    pause 10


step "copy xcode into the guest"
  # THE .xip IS A PREPARED INPUT, PULLED BY THE WORKFLOW BEFORE THIS FILE RUNS. It used to be a
  # `fetch:` step here, which meant a 1.5 GiB download inside a stage whose job has a wall clock -
  # the same fault that cost run 43847000071 eighteen minutes before its first boot.
  copy Xcode_26.6_Universal.xip /tmp/Xcode.xip


step "copy run-xcode-install.sh in"
  copy run-xcode-install.sh /tmp/run-xcode-install.sh
  timeout 300


step "expand and select xcode"
  ssh "bash /tmp/run-xcode-install.sh '{{ password }}'"
  timeout 7200


step "remove the xip"
  ssh "rm -f /Users/{{ user }}/Xcode.xip && df -h / | tail -1"
  timeout 300


step "copy the packages into the guest"
  # TWO FILES, NOT A TARBALL, AND THE NAME `packages.tar` WAS NEVER A FILE THIS REPOSITORY PRODUCED.
  #
  # `fetchDevPackages` pulls `dev-node-pkg` and `dev-python-pkg` and writes `node.pkg` and
  # `python.pkg` - while the old step copied `packages.tar`, which nothing has ever created, and the
  # two steps below then looked for `/tmp/node.pkg` and `/tmp/python.pkg`, which were never copied.
  # The stage could not have worked. THE NAMES ON THE RIGHT ARE THE ONES THE INSTALLERS READ, and
  # the ones on the left are what the workflow's `assets:` places; both ends are spelled the same
  # way on purpose.
  copy node.pkg /tmp/node.pkg


step "copy the python package into the guest"
  # `scp:` COPIES ONE FILE PER STEP, so the second package needs its own.
  copy python.pkg /tmp/python.pkg


step "copy install-node.sh in"
  copy install-node.sh /tmp/install-node.sh
  timeout 300
# NODE FROM nodejs.org, x64 .pkg. The official installer puts it in /usr/local/bin and links
# node/npm/npx there, which is on the default PATH.


step "install node"
  ssh "bash /tmp/install-node.sh '{{ password }}'"
  timeout 1800


step "copy install-python.sh in"
  copy install-python.sh /tmp/install-python.sh
  timeout 300
# PYTHON FROM python.org, macos11 .pkg - the Intel-capable build. It installs into
# /Library/Frameworks/Python.framework and links python3 into /usr/local/bin.


step "install python"
  ssh "bash /tmp/install-python.sh '{{ password }}'"
  timeout 1800


step "copy prove-toolchain.sh in"
  copy prove-toolchain.sh /tmp/prove-toolchain.sh
  timeout 300
# THE CHECK IS THE PATH, NOT THE VERSION.
#
# /usr/bin/python3 exists on every macOS and answers --version perfectly - it is the one Xcode's
# command line tools install, and its pip refuses to write. A check that only read a version would
# pass on a disk whose python cannot install anything.
#
# WITH HOMEBREW OUT, THE EXPECTED PREFIX IS DIFFERENT: node and python come from publishers' .pkg
# files and land in /usr/local, while git and the compilers come from Xcode and live under
# /Applications/Xcode.app or /usr/bin.


step "prove the toolchain"
  ssh "bash /tmp/prove-toolchain.sh"
  timeout 300


step "prove xcode is selected"
  ssh "xcode-select -p && xcodebuild -version"
  timeout 300


step "copy swift-check.sh in"
  copy swift-check.sh /tmp/swift-check.sh
  timeout 300


step "prove swift compiles"
  ssh "bash /tmp/swift-check.sh"
  timeout 1800


step "note what is present"
  ssh "export PATH=/usr/local/bin:$PATH; echo \"node=$(node --version)\"; echo \"python=$(python3 --version)\"; echo \"git=$(git --version)\"; echo \"swift=$(swift --version 2>&1 | head -1)\"; echo \"xcode=$(xcodebuild -version | head -1)\""
  timeout 300


step "stop the machine"
  stop "{{ shutdown }}"
  timeout 300


step "publish the disk"
  save "{{ out }}"
