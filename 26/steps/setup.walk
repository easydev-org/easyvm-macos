walkthrough "macos 26 setup (recovery image to setup assistant)"
resolution 1920x1080
recording_resolution 1920x1080
var disk_name
  default main
var expected_gb
  default "68"
var out
  default out/macos26.qcow2
  from args.out
var shutdown
  default kill
  from args.shutdown
step "the recovery image this stage reads is already on disk"
  needs [recovery.dmg, boot.img, macos.rom, macos.vars]



step "create the empty disk"
  disk
    file disk.qcow2
    size 128


step "boot the recovery image"
  boot
    machine "q35,accel=kvm,vmport=off"
    args [["-m", "12288"], ["-cpu", "Skylake-Client-v4,vendor=GenuineIntel,vmx=off,vmware-cpuid-freq=on,-pdpe1gb,+invtsc,+ssse3,+sse4.2,+popcnt,+avx,+avx2,+aes,+fma,+bmi1,+bmi2,+smep,+xsave,+xsaveopt,+xgetbv1,+movbe,+rdrand,check"], ["-smp", "4,sockets=1,dies=1,cores=4,threads=1"], ["-drive", "if=pflash,format=raw,readonly=on,file=macos.rom"], ["-drive", "if=pflash,format=raw,file=macos.vars"], ["-drive", "file=boot.img,format=raw,if=none,id=oc"], ["-device", "virtio-blk-pci,drive=oc,bootindex=0"], ["-chardev", "socket,id=qga0,path=qga.sock,server=on,wait=off"], ["-device", "isa-serial,chardev=qga0"], ["-device", "qemu-xhci,id=xhci"], ["-device", "usb-tablet,bus=xhci.0"], ["-device", "usb-kbd,bus=xhci.0"], ["-drive", "file=recovery.dmg,media=disk,if=none,id=rec,readonly=on"], ["-device", "usb-storage,bus=xhci.0,drive=rec"], ["-drive", "file=disk.qcow2,if=none,format=qcow2,id=target"], ["-device", "virtio-blk-pci,drive=target,bootindex=1"], ["-global", "ICH9-LPC.disable_s3=1"], ["-global", "ICH9-LPC.disable_s4=1"], ["-global", "ICH9-LPC.acpi-pci-hotplug-with-bridge-support=off"], ["-rtc", "base=utc"], ["-smbios", "type=2"], ["-device", "vmware-svga"], ["-audiodev", "none,id=snd0"], ["-device", "usb-audio,bus=xhci.0,audiodev=snd0"], ["-device", "isa-applesmc,osk=ourhardworkbythesewordsguardedpleasedontsteal(c)AppleComputerInc"], ["-netdev", "tap,id=net0,ifname=qemutap0,script=no,downscript=no"], ["-device", "virtio-net-pci,netdev=net0,mac=52:54:00:56:4d:01,romfile=,host_mtu=1450"]]
    timeout 900
step "the recovery menu's rows"
  read
    name recovery


step "wait for the recovery menu"
  repeat
    do
      item
        settle 10
      item "read the screen"
        read
          name recovery
    until
      bind done
      source recovery
      mode text
      rect [760, 200, 1400, 560]
      rect_at [1920, 1080]
      scale 6
      words [[restore, time, machine], [reinstall, macos], [safari], [disk, utility]]
    max 180


step "select disk utility"
  input 800 523
  settle 3


step "open disk utility"
  input 1148 595
  settle 8


step "make disk utility full screen"
  at_color [40, 200, 64]
  color_region [0, 30, 700, 400]
  color_tolerance 45
  settle 6


step "select the first disk"
  input 200 132
  settle 2


step "is the selected disk the uninitialised one"
  read
    name details


step "the first disk is the uninitialised one"
  check
    source details
    mode contains
    name uninitialised
    rect [360, 105, 1100, 200]
    rect_at [1920, 1080]
    scale 4
    text Uninitialized


step "select the second disk, when row 1 was the boot image"
  if uninitialised
    else
      item "click row 2"
        input 200 164
        settle 2
      item "is the second disk the uninitialised one"
        read
          name details
      item "the second disk is the uninitialised one"
        check
          source details
          mode contains
          name uninitialised
          rect [360, 105, 1100, 200]
          rect_at [1920, 1080]
          scale 4
          text Uninitialized


step "erase - open the sheet"
  repeat
    do
      item
        input 1711 56
      item
        settle 3
      item
        settle 2
      item "read the screen"
        read
          name sheet
    until
      bind sheet_up
      source sheet
      mode text
      rect [720, 425, 1200, 680]
      rect_at [1920, 1080]
      scale 2
      words [[erase, deleted], [free, space], [security, option], [cancel, erase]]
    max 6
  settle 4


step "erase - clear the name field"
  input meta_l+a
  settle 1


step "erase - name the volume"
  settle 4
  input text "{{ disk_name }}"
    at 988 542


step "erase - confirm"
  input 1154 650
  settle 5


step "erase - wait for the report"
  repeat
    do
      item
        settle 5
      item "read the screen"
        read
          name screen
    until
      bind done
      source screen
      mode text
      rect [0, 0, 1920, 1080]
      rect_at [1920, 1080]
      scale 1
      words [[erase, complete], [erase, process]]
    max 60


step "erase - done"
  input 1147 614
  settle 5


step "close disk utility"
  input meta_l+q
  settle 12


step "the recovery menu is back"
  repeat
    do
      item
        settle 5
      item "read the screen"
        read
          name screen
    until
      bind done
      source screen
      mode text
      rect [760, 200, 1400, 560]
      rect_at [1920, 1080]
      scale 2
      words [[reinstall, macos]]
    max 60


step "select reinstall macos"
  input 837 333
  settle 3


step "open the installer"
  input 1142 586
  settle 20


step "wait for the installer to load"
  repeat
    do
      item
        settle 10
      item "read the screen"
        read
          name instaload
    until
      bind loaded
      source instaload
      mode text
      rect [400, 560, 1520, 700]
      rect_at [1920, 1080]
      scale 2
      words [[agree, to, the, terms], [english, apple], [select, the, disk], [macos]]
    max 24


step "welcome continue"
  input 960 712
  settle 5


step "wait for the licence pane"
  repeat
    do
      item
        settle 10
      item "read the screen"
        read
          name licence
    until
      bind licence_up
      source licence
      mode text
      rect [660, 430, 1260, 700]
      rect_at [1920, 1080]
      scale 2
      words [[software, license, agreement], [please, read, this]]
    max 24


step "agree to the licence"
  input 1005 713
  settle 5


step "wait for the licence sheet"
  repeat
    do
      item
        settle 5
      item "read the screen"
        read
          name sheet
    until
      bind sheet_up
      source sheet
      mode text
      rect [780, 330, 1140, 560]
      rect_at [1920, 1080]
      scale 2
      words [[read, and, agree], [disagree, agree]]
    max 12


step "agree in the sheet"
  input 1018 520
  settle 10


step "select the destination card"
  input 850 550
  settle 5


step "destination continue"
  input 1005 712
  settle 10
# THE FIRST COPY NEEDS ABOUT A HUNDRED AND FIVE MINUTES, AND THE BUDGET WAS NINETY.
#
# MEASURED ON RUN 44924742991, whose recording is the evidence and whose two frames disagree with
# each other in a way that names the bug exactly:
#
#	85 min   "macOS Tahoe will be installed on the disk Untitledmain" - "About 20 minutes remaining"
#	141 min  the Apple logo and a progress bar at FOUR PER CENT, on a copy that had restarted
#
# and whose daemon log says why:
#
#	loop: 5400s have passed, so the `clock:` actions run
#	[easyvm]   resetting the machine
#
# `max: 270` OF 20-SECOND ATTEMPTS IS 90 MINUTES, AND `every: 5400` IS 90 MINUTES - the loop's own
# ceiling and its rescue clock expired at the SAME MINUTE, and the clock reset a guest whose copy was
# twenty minutes from finishing. The second attempt then had to start from zero.
#
# SO THE BUDGET IS LARGER THAN THE MEASUREMENT RATHER THAN EQUAL TO IT: 480 attempts is 160 minutes,
# and the clock waits 200 - past the loop's own end, so it cannot fire during a copy that is making
# progress. The job's ceiling is 400 minutes, which holds one copy of this size plus the panes after
# it. A copy that has genuinely stalled now ends the loop and the reset step below runs, which is
# what the clock was for in the first place.


step "the copy runs, look 1 of at most 8"
  repeat
    do
      item
        settle 20
      item "keep the display awake - a bare shift types nothing"
        input shift
        settle 1
      item "read the pane for the cancel sheet"
        read
          name cancelshot
      item "classify - the cancel confirmation"
        check
          source cancelshot
          mode text
          name cancel_sheet
          rect [820, 300, 1100, 600]
          rect_at [1920, 1080]
          scale 1
          words [[continue, installing]]
      item "answer the cancel confirmation"
        if cancel_sheet
          then
            item "continue installing"
              input 960 508
              settle 10
      item
        settle 2
      item "read the screen"
        read
          name screen
    until
      bind done
      source screen
      mode matches
      pattern "select your country or region|transfer your information to this mac|choose a wireless network|sign in with your apple id|update mac automatically|choose your look"
      rect [0, 0, 1920, 1080]
      rect_at [1920, 1080]
      scale 1
    # NINETY MINUTES, MEASURED - AND IT WAS TWO HUNDRED, WHICH IS WHY THIS LOOK NEVER RESET AT ALL.
    #
    # THE INSTALLER GOES BLACK AND STAYS BLACK FOR TWENTY MINUTES, and that is normal rather than a
    # stall: it swaps its own graphics stack. MEASURED on this repository's own recording of run
    # 45189639097 - frames taken every ten minutes from t=1800 to t=6000 showed the progress bar
    # holding 18 bright pixels, and the OCR reading the whole time was `"e"`. That is the shape
    # ../../easyvm-26's upstream describes as "about 21 minutes of copying before the screen blanks
    # on top of the ~21 minutes the countdown still owed, so about 42 minutes to a first draw".
    #
    # SO A RESET IS WHAT MOVES IT, AND `nudge 12000` MEANT NO RESET FOR THREE AND A HALF HOURS. The
    # stage's own `timeout: 180` kills the leg long before that, so look 1 could only ever run out the
    # job - which is exactly what happened: the run was cancelled at 101 minutes with the bar still at
    # 18 pixels and the first nudge still two hours away.
    #
    # NINETY IS THE UPSTREAM'S NUMBER and it is twice the observed 42-minute first draw, which leaves
    # a wide margin for a slow runner. The looks after this one keep their ten minutes, because by then
    # the installer has already been through its graphics swap.
    max 400
    nudge 5400
      item "pick macOS Installer in OpenCore's picker, if that is what is up"
        input 731 547
        settle 15
      item "reset the guest"
        acpi reset
        timeout 300
      item "give it time to come back"
        settle 60


step "reset the guest after look 1, because this installer stalls and a reset is what moves it"
  acpi reset
  timeout 300


step "wait for the guest to be drawing again after reset 1"
  repeat
    do
      item
        settle 10
      item "read the screen"
        read
          name back1
    until
      bind anything1
      source back1
      mode matches
      pattern .
      rect [0, 0, 1920, 1080]
      rect_at [1920, 1080]
      scale 1
    max 40


step "the copy runs, look 2 of at most 8"
  repeat
    do
      item
        settle 20
      item "keep the display awake - a bare shift types nothing"
        input shift
        settle 1
      item
        settle 2
      item "read the screen"
        read
          name screen
    until
      bind done
      source screen
      mode matches
      pattern "select your country or region|transfer your information to this mac|choose a wireless network|sign in with your apple id|update mac automatically|choose your look"
      rect [0, 0, 1920, 1080]
      rect_at [1920, 1080]
      scale 1
    max 30
    nudge 600
      item "pick macOS Installer in OpenCore's picker, if that is what is up"
        input 731 547
        settle 15
      item "reset the guest"
        acpi reset
        timeout 300
      item "give it time to come back"
        settle 60


